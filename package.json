{
  "name": "ejo100",
  "private": true,
  "version": "1.0.0",
  "description": "EJO 100 Enterprise Platform - reusable Enterprise Operating System (EnterpriseOS)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:website": "npm run dev --workspace=apps/website",
    "dev:portal": "npm run dev --workspace=apps/portal",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "5.6.3"
  },
  "overrides": {
    "typescript": "5.6.3",
    "next": "^15.5.27",
    "multer": "^2.3.0",
    "lodash": "^4.18.1",
    "body-parser": "^1.20.6",
    "qs": "^6.16.0",
    "postcss": "^8.5.23"
  },
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  }
}

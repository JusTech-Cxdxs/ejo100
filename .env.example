# ---------------------------------------------------------------------------
# EJO 100 Enterprise Platform - environment variables (example values only)
# Copy to .env for local work and fill in real values. Never commit .env.
# In Vercel / Render, set these per project and per environment.
# docs/OPERATIONS_CHECKLIST.md says which project needs which value.
# ---------------------------------------------------------------------------

# Database (Supabase Postgres). DATABASE_URL is the pooled connection used at
# run time; DIRECT_URL is the direct connection Prisma needs for schema
# changes. Plain Postgres connection strings, so another provider only means
# changing these two values.
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# First administrator account, created by packages/database/prisma/seed.ts.
# The password is used only when the account is first created. Re-running the
# seed never changes an existing password unless RESET_MASTER_ADMIN_PASSWORD=yes.
# Remove it from hosting environments once the account exists.
MASTER_ADMIN_NAME="Platform Administrator"
MASTER_ADMIN_EMAIL="admin@example.com"
MASTER_ADMIN_PASSWORD="change-me-to-a-long-unique-password"

# The platform owner account (only the owner can change it).
PLATFORM_OWNER_EMAIL="owner@example.com"

# Auth (Better Auth). The secret is shared by the portal, the website and the
# API; generate it with: openssl rand -base64 48
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
# The portal's own address (staff sign-in).
BETTER_AUTH_URL="http://localhost:3001"
# Extra addresses allowed to call the sign-in endpoints, comma-separated
# (e.g. the vercel.app address while a custom domain is the main one).
# BETTER_AUTH_TRUSTED_ORIGINS="https://portal.example.com"
# Only when a proxy in front of the app changes the host name (comma-separated hosts).
# SERVER_ACTIONS_ALLOWED_ORIGINS="portal.example.com"

# Public addresses (required in production; a production build on Vercel
# stops when they are missing).
NEXT_PUBLIC_WEBSITE_URL="http://localhost:3000"
NEXT_PUBLIC_PORTAL_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# The organisation's identity, shown before anyone signs in (portal sign-in
# pages) and across the public website. Inside the portal, the organisation
# record in the database is used. NEXT_PUBLIC_* values are read at build
# time: redeploy after changing them.
NEXT_PUBLIC_ORGANISATION_NAME="Example Group"
# NEXT_PUBLIC_ORGANISATION_LEGAL_NAME="Example Holdings Limited"
# NEXT_PUBLIC_ORGANISATION_FOUNDED_YEAR="1990"
# NEXT_PUBLIC_SITE_TAGLINE="One line under the name"
# NEXT_PUBLIC_SITE_DESCRIPTION="Two sentences for search engines and link previews."
# NEXT_PUBLIC_CONTACT_EMAIL="info@example.com"
# NEXT_PUBLIC_CONTACT_PHONE="+234 800 000 0000"
# NEXT_PUBLIC_CONTACT_ADDRESS="12 Example Road, Ikeja, Lagos"
# NEXT_PUBLIC_SOCIAL_FACEBOOK="https://facebook.com/example"
# NEXT_PUBLIC_SOCIAL_LINKEDIN="https://linkedin.com/company/example"
# NEXT_PUBLIC_SOCIAL_X="https://x.com/example"
# NEXT_PUBLIC_SOCIAL_YOUTUBE="https://youtube.com/@example"
# NEXT_PUBLIC_SOCIAL_INSTAGRAM="https://instagram.com/example"

# Email (Nodemailer). SMTP_FROM's display name is what customers see.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Example Group <no-reply@example.com>"

# Scheduled jobs (Vercel Cron and the Supabase scheduler send it as a bearer token).
CRON_SECRET="replace-with-a-long-random-secret"

# How many days a record deleted by mistake stays restorable in the Recycle bin
# (optional; default 30, kept between 7 and 90). The daily clean-up then removes it.
# RECYCLE_BIN_DAYS="30"

# Sign-in rate limits per internet address (optional; defaults 20 a minute and 5 resets per 5 minutes).
# AUTH_SIGNIN_PER_MINUTE="20"
# AUTH_RESET_REQUESTS_PER_5_MIN="5"
# CUSTOMER_SIGNIN_PER_MINUTE="20"
# CUSTOMER_RESET_REQUESTS_PER_5_MIN="5"

# Instant notifications (optional): Supabase Realtime "something changed"
# pings. Both values are public by design (Supabase → Project Settings → API).
# No business data travels on the channel. Without them the portal checks
# every 5 seconds instead.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-me-with-the-anon-public-key"

# Storage (planned; not read by the code yet).
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="replace-me"
# SUPABASE_STORAGE_BUCKET="documents"
# REDIS_URL="redis://localhost:6379"

# ── Enyo 1.0 (AI) — portal AND website ─────────────────────────────────
# Any OpenAI-compatible model server. Leave unset and Enyo shows "not switched
# on yet"; the ERP works exactly as before. Server-side only: never prefix
# these with NEXT_PUBLIC_.
#   Free hosted tier (demo data only; check the provider's data terms):
#     ENYO_LLM_BASE_URL="https://api.groq.com/openai/v1"
#   The company's own model server (no key needed on localhost):
#     ENYO_LLM_BASE_URL="http://localhost:11434/v1"   (Ollama)
# ENYO_LLM_BASE_URL=""
# ENYO_LLM_API_KEY=""
# ENYO_LLM_MODEL=""            # a model that supports tool calling
# ENYO_LLM_FAST_MODEL=""       # optional smaller model for briefs and text refinement
# ENYO_LLM_PROVIDER_LABEL=""   # optional, shown on Settings → Enyo
# ENYO_LLM_TIMEOUT_MS="45000"
# Requests per person per minute (optional).
# ENYO_REQUESTS_PER_MINUTE="20"

# Connected mailboxes (portal): 32 random bytes, base64. Encrypts each
# mailbox password at rest. Generate: openssl rand -base64 32
# Changing it disconnects every mailbox (people reconnect once).
# MAILBOX_ENCRYPTION_KEY=""
# Test mail servers only (CI GreenMail on localhost): plain connections, any
# port, private addresses. Never set in production (ignored on Vercel production).
# MAILBOX_ALLOW_INSECURE="1"

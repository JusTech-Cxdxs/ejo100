  @@map("security_email_logs")
}

// Road Test Permit: a workshop vehicle leaving the compound for a road test
// (quality check). Requested on a Job Card / Vehicle Service, approved by
// the Manager, timed and odometer-read out and back by Security.
enum RoadTestStatus {
  PENDING_MANAGER
  APPROVED
  OUT
  RETURNED
  DECLINED
  CANCELLED
}

model RoadTestPermit {
  id                      String         @id @default(cuid())
  permitNumber            String         @unique
  branchId                String
  status                  RoadTestStatus @default(PENDING_MANAGER)
  jobCardId               String?
  vehicleServiceId        String?
  vehicleId               String
  requestedById           String
  driverId                String
  purpose                 String
  route                   String?
  expectedDurationMinutes Int
  managerApprovedById     String?
  managerApprovedAt       DateTime?
  declinedById            String?
  declinedAt              DateTime?
  declineReason           String?
  cancelReason            String?
  gateOutAt               DateTime?
  gateOutById             String?

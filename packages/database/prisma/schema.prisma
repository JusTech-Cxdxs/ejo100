// ============================================================================
// EJO 100 — core database schema
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (used at runtime)
  directUrl = env("DIRECT_URL")   // direct connection (used for migrations / prisma db push)
}

// ----------------------------------------------------------------------------
// MODULE REGISTRY: which modules are live. The portal's sidebar and router
// read this, so activating a module is configuration only.
// ----------------------------------------------------------------------------
enum ModuleStatus {
  LIVE
  COMING_SOON
  DISABLED
}

model PlatformModule {
  id          String       @id @default(cuid())
  key         String       @unique // e.g. "workshop", "hr", "finance"
  name        String
  description String?
  status      ModuleStatus @default(COMING_SOON)
  sortOrder   Int          @default(0)
  icon        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organisationModules OrganisationModule[]

  @@map("platform_modules")
}

// Per-organisation override of a module's status (e.g. COMING_SOON platform-wide
// but LIVE for one organisation).
model OrganisationModule {
  id        String       @id @default(cuid())
  organisationId String
  moduleId  String
  status    ModuleStatus
  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  module    PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([organisationId, moduleId])
  @@map("organisation_modules")
}

// ----------------------------------------------------------------------------
// BRANDING: one row per organisation; the portal, PDFs and emails read their
// colours from here.
// ----------------------------------------------------------------------------
model Branding {
  id              String   @id @default(cuid())
  organisationId       String   @unique
  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  logoUrl         String?
  logoDarkUrl     String?
  faviconUrl      String?

  primaryColor    String   @default("#16A34A") // brand green
  secondaryColor  String   @default("#0F172A")
  accentColor     String   @default("#22C55E")
  successColor    String   @default("#16A34A")
  warningColor    String   @default("#F59E0B")
  errorColor      String   @default("#DC2626")
  infoColor       String   @default("#2563EB")

  fontFamily      String   @default("Inter")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("branding")
}

// ----------------------------------------------------------------------------
// ORGANISATION HIERARCHY
// Platform -> Organisation -> Business Unit -> Country -> State -> City -> Branch
//   -> Department -> Team -> User
// Every level is ordinary data; nothing is specific to one organisation.
// ----------------------------------------------------------------------------

model Organisation {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  legalName   String?
  website     String?
  // Contact and registration details printed on letterheads and receipts.
  // All optional. Hotlines are a string array, printed in order.
  hotlines    String[] @default([])
  hqAddress   String?
  poBox       String?
  rcNumber    String?
  email       String?
  // Primary Service interval ("whichever comes first"), the basis for
  // next-service predictions. Null until the organisation sets it; no
  // prediction is made without it.
  primaryServiceIntervalKm   Int?
  primaryServiceIntervalDays Int?
  // Data Exchange: days after an import is finished (and its totals signed
  // off) before the staged copy of its file is released. Null = 30; 0 = never.
  importStagingDays Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branding      Branding?
  businessUnits BusinessUnit[]
  organisationModules OrganisationModule[]
  users         User[]
  roles         Role[]
  customers     Customer[]
  announcements Announcement[]

  @@map("organisations")
  broadcasts Broadcast[]
  importJobs ImportJob[]
  importMappingProfiles ImportMappingProfile[]
  suppliers  Supplier[]
  historicalInvoices    HistoricalInvoice[]
  vehicleHistoryRecords VehicleHistoryRecord[]
}

model BusinessUnit {
  id        String   @id @default(cuid())
  organisationId String
  name      String   // e.g. "Automobile Division", "Afprint", "Sunola Foods"
  slug      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  countries CountryLink[]
  branches  Branch[]

  @@unique([organisationId, slug])
  @@map("business_units")
}

model Country {
  id       String @id @default(cuid())
  name     String @unique // e.g. "Nigeria"
  isoCode  String @unique // e.g. "NG"

  states       State[]
  businessUnits CountryLink[]

  @@map("countries")
}

// Join table: which business units operate in which countries.
model CountryLink {
  id             String       @id @default(cuid())
  businessUnitId String
  countryId      String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  country        Country      @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([businessUnitId, countryId])
  @@map("business_unit_countries")
}

model State {
  id        String   @id @default(cuid())
  countryId String
  name      String   // e.g. "Lagos State"

  country   Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities    City[]

  @@unique([countryId, name])
  @@map("states")
}

model City {
  id      String @id @default(cuid())
  stateId String
  name    String // e.g. "Isolo"

  state    State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  branches Branch[]

  @@unique([stateId, name])
  @@map("cities")
}

model Branch {
  id             String   @id @default(cuid())
  businessUnitId String
  cityId         String
  name           String   // e.g. "Isolo Branch"
  code           String?  // short code used in document numbering, e.g. "KWL-WS"
  address        String?
  // The branch's own hotlines, printed separately from the organisation's
  // (e.g. head office and a workshop branch on the same Job Card).
  hotlines       String[] @default([])
  email          String?
  // The branch's own bank account for customer deposits and payments —
  // printed on every estimate email, PDF and print-out for this branch.
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  city         City         @relation(fields: [cityId], references: [id], onDelete: Cascade)
  departments  Department[]
  users        User[]
  jobCards     JobCard[]
  parts          Part[]
  goodsReceipts  GoodsReceipt[]
  partRequestSlips PartRequestSlip[]
  externalProcurementRequests ExternalProcurementRequest[]
  partCategories PartCategory[]
  partTypes      PartType[]
  vehicleServices VehicleService[]

  @@map("branches")
  visits Visit[]
  exitPasses ExitPass[]
  vehicleGateExits VehicleGateExit[]
  roadTestPermits RoadTestPermit[]
  meetingRooms MeetingRoom[]
  appointments Appointment[]
  securityIncidents SecurityIncident[]
  gateDeliveries GateDelivery[]
  contractorPasses ContractorPass[]
}

model Department {
  id        String   @id @default(cuid())
  branchId  String
  name      String   // e.g. "Workshop", "HR", "Finance", "Store"
  slug      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  teams  Team[]
  users  User[]
  jobCards JobCard[]
  vehicleServices VehicleService[]

  @@unique([branchId, slug])
  @@map("departments")
}

model Team {
  id           String   @id @default(cuid())
  departmentId String
  name         String   // e.g. "Technicians", "Store Officers"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users      User[]

  @@map("teams")
}

// ----------------------------------------------------------------------------
// IDENTITY & ACCESS
// User = employees and platform administrators only. Customers are a separate
// model (CUSTOMER section below), so a staff account can never satisfy a
// customer query, or the reverse.
//
// Session / Account / Verification follow Better Auth's adapter schema
// (https://www.better-auth.com); field names are set by that library.
// Customers have their own tables (CustomerSession, CustomerAccount,
// CustomerVerification) used by the website's separate auth instance.
// ----------------------------------------------------------------------------

enum AccountType {
  EMPLOYEE
  ADMIN
}

model User {
  id            String      @id @default(cuid())
  // Nullable: an account may exist before an administrator places it in an
  // organisation. Such a user sees nothing beyond their own account settings.
  organisationId     String?
  branchId      String?
  departmentId  String?
  teamId        String?

  accountType   AccountType @default(EMPLOYEE)

  employeeId    String?     @unique // human-facing staff number
  fullName      String
  email         String      @unique
  emailVerified Boolean     @default(false) // required by Better Auth
  image         String?                     // required by Better Auth (avatar URL)
  phone         String?
  photoUrl      String?

  isActive      Boolean     @default(true)
  lastLoginAt   DateTime?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  organisation Organisation?    @relation(fields: [organisationId], references: [id])
  branch     Branch?     @relation(fields: [branchId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  team       Team?       @relation(fields: [teamId], references: [id])

  roles           UserRole[]
  sessions        Session[]
  accounts        Account[]
  employeeProfile EmployeeProfile?
  jobCardsAssigned JobCard[] @relation("JobCardTechnician")
  jobCardsSupervised JobCard[] @relation("JobCardSupervisor")
  jobCardsApproved JobCard[] @relation("JobCardApprovedBy")
  estimateLineItemsEntered EstimateLineItem[]
  estimatesCreated Estimate[] @relation("EstimateCreatedBy")
  estimatesApproved Estimate[] @relation("EstimateApprovedBy")
  estimatesManagerApproved Estimate[] @relation("EstimateManagerApprovedBy")
  estimatesCustomerNotified Estimate[] @relation("EstimateCustomerNotifiedBy")
  estimatesMatchingRequested Estimate[] @relation("EstimateMatchingRequestedBy")
  paymentsRecorded Payment[]
  cancellationRequestsMade CancellationRequest[] @relation("CancellationRequestedBy")
  cancellationRequestsDecided CancellationRequest[] @relation("CancellationDecidedBy")
  closeRequestsMade CloseRequest[] @relation("CloseRequestedBy")
  closeRequestsDecided CloseRequest[] @relation("CloseDecidedBy")
  pricingAlertsResolved PricingAlert[] @relation("PricingAlertResolvedBy")
  announcementsCreated Announcement[] @relation("AnnouncementCreatedBy")
  vehicleServicesCreated VehicleService[] @relation("VehicleServiceCreatedBy")
  vehicleServicesAssigned VehicleService[] @relation("VehicleServiceTechnician")
  vehicleServicesSupervised VehicleService[] @relation("VehicleServiceSupervisor")
  vehicleServicesApproved VehicleService[] @relation("VehicleServiceApprovedBy")
  vehicleInspections VehicleInspection[] @relation("VehicleInspectionInspector")
  serviceEstimatesCreated ServiceEstimate[] @relation("ServiceEstimateCreatedBy")
  serviceEstimatesApproved ServiceEstimate[] @relation("ServiceEstimateApprovedBy")
  serviceEstimatesManagerApproved ServiceEstimate[] @relation("ServiceEstimateManagerApprovedBy")
  serviceEstimatesCustomerNotified ServiceEstimate[] @relation("ServiceEstimateCustomerNotifiedBy")
  vehicleServiceCloseRequestsMade VehicleServiceCloseRequest[] @relation("VehicleServiceCloseRequestedBy")
  vehicleServiceCloseRequestsDecided VehicleServiceCloseRequest[] @relation("VehicleServiceCloseDecidedBy")
  refundsRecorded Refund[] @relation("RefundRecordedBy")
  vehicleServiceCancellationRequestsMade VehicleServiceCancellationRequest[] @relation("VehicleServiceCancellationRequestedBy")
  vehicleServiceCancellationRequestsDecided VehicleServiceCancellationRequest[] @relation("VehicleServiceCancellationDecidedBy")
  serviceEstimatesMatchingRequested ServiceEstimate[] @relation("ServiceEstimateMatchingRequestedBy")
  serviceEstimateLinesEntered ServiceEstimateLineItem[] @relation("ServiceEstimateLineEnteredBy")
  jobCardsCreated  JobCard[] @relation("JobCardCreatedBy")
  customersCreated Customer[] @relation("CustomerCreatedBy")
  vehiclesCreated  CustomerVehicle[] @relation("VehicleCreatedBy")
  partsCreated       Part[] @relation("PartCreatedBy")
  partCategoriesCreated PartCategory[] @relation("PartCategoryCreatedBy")
  partTypesCreated      PartType[] @relation("PartTypeCreatedBy")
  goodsReceiptsTaken GoodsReceipt[] @relation("GoodsReceiptReceivedBy")
  partRequestSlipsRequested    PartRequestSlip[] @relation("PartRequestSlipRequestedBy")
  partRequestSlipsHodApproved  PartRequestSlip[] @relation("PartRequestSlipHodApprovedBy")
  partRequestSlipsStoreApproved PartRequestSlip[] @relation("PartRequestSlipStoreApprovedBy")
  partRequestSlipsReleased     PartRequestSlip[] @relation("PartRequestSlipReleasedBy")
  partRequestSlipsRejected     PartRequestSlip[] @relation("PartRequestSlipRejectedBy")
  partRequestSlipsReceived     PartRequestSlip[] @relation("PartRequestSlipReceivedBy")
  externalProcurementRequested       ExternalProcurementRequest[] @relation("ExternalProcurementRequestedBy")
  externalProcurementFinanceReviewed ExternalProcurementRequest[] @relation("ExternalProcurementFinanceReviewedBy")
  externalProcurementManagerApproved ExternalProcurementRequest[] @relation("ExternalProcurementManagerApprovedBy")
  externalProcurementDisbursed        ExternalProcurementRequest[] @relation("ExternalProcurementDisbursedBy")
  externalProcurementRejected         ExternalProcurementRequest[] @relation("ExternalProcurementRejectedBy")
  externalProcurementRetired          ExternalProcurementRequest[] @relation("ExternalProcurementRetiredBy")
  externalProcurementSupplementaryLinesAdded ExternalProcurementSupplementaryLine[] @relation("ExternalProcurementSupplementaryLineAddedBy")

  @@index([organisationId])
  @@index([branchId])
  @@map("users")
  warrantyProvidersCreated WarrantyProvider[] @relation("WarrantyProviderCreatedBy")
  warrantyPoliciesCreated WarrantyPolicy[] @relation("WarrantyPolicyCreatedBy")
  warrantiesIssued Warranty[] @relation("WarrantyIssuedBy")
  warrantiesVerified Warranty[] @relation("WarrantyVerifiedBy")
  warrantyPolicyDeletionsRequested WarrantyPolicyDeletionRequest[] @relation("WarrantyPolicyDeletionRequestedBy")
  warrantyPolicyDeletionsHodDecided WarrantyPolicyDeletionRequest[] @relation("WarrantyPolicyDeletionHodDecidedBy")
  warrantyPolicyDeletionsManagerDecided WarrantyPolicyDeletionRequest[] @relation("WarrantyPolicyDeletionManagerDecidedBy")
  warrantyClaimsCreated WarrantyClaim[] @relation("WarrantyClaimCreatedBy")
  warrantyClaimsHodApproved WarrantyClaim[] @relation("WarrantyClaimHodApprovedBy")
  warrantyClaimsManagerApproved WarrantyClaim[] @relation("WarrantyClaimManagerApprovedBy")
  warrantyClaimsSubmitted WarrantyClaim[] @relation("WarrantyClaimSubmittedBy")
  warrantyClaimsDecided WarrantyClaim[] @relation("WarrantyClaimDecidedBy")
  warrantyClaimsSettled WarrantyClaim[] @relation("WarrantyClaimSettledBy")
  warrantyProviderDeletionsRequested WarrantyProviderDeletionRequest[] @relation("WarrantyProviderDeletionRequestedBy")
  warrantyProviderDeletionsHodDecided WarrantyProviderDeletionRequest[] @relation("WarrantyProviderDeletionHodDecidedBy")
  warrantyProviderDeletionsManagerDecided WarrantyProviderDeletionRequest[] @relation("WarrantyProviderDeletionManagerDecidedBy")
  visitsHosted Visit[] @relation("VisitHost")
  visitsRegistered Visit[] @relation("VisitRegisteredBy")
  visitsCheckedIn Visit[] @relation("VisitCheckedInBy")
  visitsCheckedOut Visit[] @relation("VisitCheckedOutBy")
  exitPassesRequested ExitPass[] @relation("ExitPassRequestedBy")
  exitPassesHeadApproved ExitPass[] @relation("ExitPassHeadApprovedBy")
  exitPassesManagerApproved ExitPass[] @relation("ExitPassManagerApprovedBy")
  visitsReceived Visit[] @relation("VisitReceivedBy")
  exitPassesDeclined ExitPass[] @relation("ExitPassDeclinedBy")
  exitPassesGateOut ExitPass[] @relation("ExitPassGateOutBy")
  exitPassesGateIn ExitPass[] @relation("ExitPassGateInBy")
  exitPassPersons ExitPassPerson[] @relation("ExitPassPersonUser")
  roadTestPersons RoadTestPerson[] @relation("RoadTestPersonUser")
  vehicleGateExits VehicleGateExit[] @relation("VehicleGateExitBy")
  roadTestsRequested RoadTestPermit[] @relation("RoadTestRequestedBy")
  roadTestsDriven RoadTestPermit[] @relation("RoadTestDriver")
  roadTestsApproved RoadTestPermit[] @relation("RoadTestManagerApprovedBy")
  roadTestsDeclined RoadTestPermit[] @relation("RoadTestDeclinedBy")
  roadTestsGateOut RoadTestPermit[] @relation("RoadTestGateOutBy")
  roadTestsGateIn RoadTestPermit[] @relation("RoadTestGateInBy")
  calendarDelegatesAsOwner CalendarDelegate[] @relation("CalendarOwner")
  calendarDelegatesAsAide CalendarDelegate[] @relation("CalendarDelegateUser")
  calendarDelegatesCreated CalendarDelegate[] @relation("CalendarDelegateCreatedBy")
  appointmentsOwned Appointment[] @relation("AppointmentOwner")
  appointmentsCreated Appointment[] @relation("AppointmentCreatedBy")
  appointmentParticipations AppointmentParticipant[] @relation("AppointmentParticipantUser")
  incidentsReported SecurityIncident[] @relation("IncidentReportedBy")
  incidentsAssigned SecurityIncident[] @relation("IncidentAssignedTo")
  incidentsClosed SecurityIncident[] @relation("IncidentClosedBy")
  deliveriesRegistered GateDelivery[] @relation("DeliveryRegisteredBy")
  deliveriesArrived GateDelivery[] @relation("DeliveryArrivedBy")
  deliveriesReceived GateDelivery[] @relation("DeliveryReceivedBy")
  deliveriesLeft GateDelivery[] @relation("DeliveryLeftBy")
  contractorsHosted ContractorPass[] @relation("ContractorHost")
  contractorsRequested ContractorPass[] @relation("ContractorRequestedBy")
  contractorsApproved ContractorPass[] @relation("ContractorApprovedBy")
  contractorsRevoked ContractorPass[] @relation("ContractorRevokedBy")
  contractorSignIns ContractorAttendance[] @relation("ContractorSignedInBy")
  contractorSignOuts ContractorAttendance[] @relation("ContractorSignedOutBy")
  broadcastsCreated Broadcast[] @relation("BroadcastCreatedBy")
  broadcastsStopped Broadcast[] @relation("BroadcastStoppedBy")
  notificationReads NotificationRead[] @relation("NotificationReads")
  customerNotes     CustomerNote[]     @relation("CustomerNoteAuthor")
  assistsGiven      AssistSession[]    @relation("AssistSessionAssistant")
  assistsReceived   AssistSession[]    @relation("AssistSessionSubject")
  notificationPreference NotificationPreference? @relation("NotificationPreference")
  importJobsCreated  ImportJob[] @relation("ImportJobCreatedBy")
  importJobsApproved ImportJob[] @relation("ImportJobApprovedBy")
  importMappingProfilesCreated ImportMappingProfile[] @relation("ImportMappingProfileCreatedBy")
  suppliersCreated  Supplier[] @relation("SupplierCreatedBy")
}

// One-to-one HR extension of User, keeping the identity table small.
model EmployeeProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Employment
  jobTitle         String?
  employmentType   String?   // Full-time, Part-time, Contract, Intern, NYSC, Consultant...
  employmentStatus String?   // Active, Suspended, On Leave, Resigned, Retired, Terminated
  dateEmployed     DateTime?
  reportingManagerId String?

  // Emergency contact (one per employee).
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?

  // Signature / notification preferences
  signatureUrl               String?
  notifyByEmail               Boolean @default(true)
  notifyByInApp                Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents EmployeeDocument[]

  @@map("employee_profiles")
}

model EmployeeDocument {
  id                String          @id @default(cuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  type    String // CV, Employment Letter, Contract, Certificate, Medical Fitness...
  fileUrl String
  uploadedAt DateTime @default(now())

  @@map("employee_documents")
}

model Role {
  id          String   @id @default(cuid())
  organisationId   String
  name        String   // e.g. "Technician", "Workshop Supervisor", "Administrator"
  slug        String
  description String?
  isSystem    Boolean  @default(false) // true for built-in roles that can't be deleted
  // Bypasses permission checks entirely: every current and future permission
  // without RolePermission rows. Only for the platform's Master Administrator
  // role; never grant it to organisation roles.
  isSuperAdmin Boolean @default(false)

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([organisationId, slug])
  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique // e.g. "workshop.job_card.approve"
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ----------------------------------------------------------------------------
// CUSTOMER IDENTITY: separate from User (employees). A customer session can
// never resolve to a User row, so a customer account cannot reach a staff
// route.
// ----------------------------------------------------------------------------

// Individual or organisation (e.g. a trading company). `fullName` on
// Customer holds either a person's or an organisation's name, as on the
// paper estimate form.
enum CustomerType {
  INDIVIDUAL
  ORGANIZATION
}

model Customer {
  id            String       @id @default(cuid())
  organisationId     String       // which organisation this customer belongs to

  customerType  CustomerType @default(INDIVIDUAL)
  fullName      String
  // Primary address: one short line printed on the Job Card (max 80 characters,
  // enforced in the app). Extra addresses go in CustomerAddress.
  address       String?
  // Optional (v-A0): customers brought in from SAP or old spreadsheets often
  // have no email, or share a fleet address. Unique when present (Postgres
  // allows many NULLs under a unique index). Only a customer with a real,
  // verified email can use the customer portal; the others are full CRM
  // records reached by phone. Never filled with a made-up address.
  email         String?      @unique
  emailVerified Boolean      @default(false)
  image         String?
  phone         String?
  // v28 CRM: an optional second number. Primary address and phone are
  // required for customers registered from v28 (enforced in the app; older
  // records may lack them and are flagged in the CRM).
  altPhone      String?
  // Free labels the organisation uses to group customers ("Fleet", "VIP").
  tags          String[] @default([])
  // The customer's own choice: also receive updates by email.
  notifyByEmail Boolean  @default(true)

  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?

  // The number this customer has in another system (v-A0): externalSource is
  // where it came from (SAP, LEGACY_EXCEL), externalId the number there (the
  // SAP business partner / KUNNR). Unique per organisation and source, so an
  // import matched on it never creates the same customer twice.
  externalSource String?
  externalId     String?
  // The import that created this customer (Data Exchange): "Undo this import" removes exactly these.
  importJobId    String?
  // v-A3: when they became a customer of the business — from SAP (the business
  // partner's creation date, ERDAT) or the old system — which can be years
  // before this record was made (createdAt). Analytics read customerSince when
  // present, otherwise createdAt.
  customerSince  DateTime? @db.Date

  // Nullable: customers who sign themselves up have no staff creator.
  createdById   String?
  createdBy     User?    @relation("CustomerCreatedBy", fields: [createdById], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  sessions   CustomerSession[]
  accounts   CustomerAccount[]

  customerCompany CustomerCompany?
  vehicles        CustomerVehicle[]
  addresses       CustomerAddress[]
  contacts        CustomerContact[]
  jobCards        JobCard[]
  vehicleServices VehicleService[]

  @@index([organisationId])
  @@unique([organisationId, externalSource, externalId])
  @@index([importJobId])
  // Search by the SAP / old-system number alone.
  @@index([organisationId, externalId])
  @@map("customers")
  warranties      Warranty[]
  warrantyClaims WarrantyClaim[]
  notes           CustomerNote[]
  notificationReads CustomerNotificationRead[]
}

// Optional company details when the customer is a business (fleet account).
model CustomerCompany {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  companyName String
  taxId       String?

  @@map("customer_companies")
}

model CustomerVehicle {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  make         String?
  model        String?
  vehicleType  VehicleCategory? // Passenger vs Commercial — the Workshop's two operational sections
  year         Int?
  plateNumber  String?  @unique // no two vehicles may share a plate
  chassisNumber String? @unique // VIN — globally unique per vehicle by definition
  engineNumber String?
  // Engine type (e.g. "ISF2.8", "4HK1"), the key for parts fitment. Not the
  // engine serial number (engineNumber). One model name can have different
  // engines, and different models can share one.
  engineType   String?
  mileage       Int?     // last known odometer reading, updated at each Job Card check-in
  // The vehicle's own service interval, overriding the organisation's
  // default (Organisation.primaryServiceIntervalKm/Days) when set.
  serviceIntervalKm   Int?
  serviceIntervalDays Int?

  // The vehicle's number in another system (v-A0), e.g. SAP equipment number.
  // Vehicles have no organisation column of their own (they belong through the
  // customer), so this is indexed, and the importer checks it within the
  // customer's organisation. The VIN and plate stay the real unique keys.
  externalSource String?
  externalId     String?
  // The import that created this vehicle (Data Exchange).
  importJobId    String?

  createdById String? // staff member who registered this vehicle
  createdBy   User?   @relation("VehicleCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  jobCards JobCard[]
  vehicleServices VehicleService[]
  reminderLogs ServiceReminderLog[]

  @@index([customerId])
  @@index([externalSource, externalId])
  @@index([externalId])
  @@index([importJobId])
  @@map("customer_vehicles")
  warranties Warranty[]
  warrantyClaims WarrantyClaim[]
  gateExits VehicleGateExit[]
  roadTestPermits RoadTestPermit[]
}

enum VehicleCategory {
  PASSENGER
  COMMERCIAL
}

enum VehicleInspectionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

// Four levels, the same vocabulary as Service Health.
enum InspectionSeverity {
  GOOD
  ATTENTION
  SERVICE_REQUIRED
  CRITICAL
}

// ----------------------------------------------------------------------------
// WORKSHOP
// ----------------------------------------------------------------------------

enum JobCardStatus {
  CHECKED_IN
  IN_PROGRESS
  AWAITING_PARTS
  QUALITY_CHECK
  // The approved estimate has been sent to the customer (set by
  // notifyCustomerOfApprovedEstimate). Work waits for the deposit.
  AWAITING_CUSTOMER_APPROVAL
  COMPLETED
  READY_FOR_COLLECTION
  CLOSED
  // The vehicle has left the workshop. Distinct from CLOSED, which is an
  // administrative sign-off while the vehicle may still be in the yard.
  // Reached from CLOSED, or from CANCELLED when the vehicle is handed back
  // (the only move out of CANCELLED).
  CHECKED_OUT
  CANCELLED
}

// Separate from JobCardStatus; see JobCard.approvalStatus.
enum JobCardApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Whether the assigned technician has accepted the work. Same shape as
// JobCardApprovalStatus.
enum TechnicianAcceptanceStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model JobCard {
  id          String        @id @default(cuid())
  jobNumber   String        @unique // human-facing, e.g. "JC-2026-000123" — generated server-side, never user-entered
  branchId    String
  customerId  String
  vehicleId   String
  // Passenger or Commercial Workshop department, derived from
  // vehicle.vehicleType at creation. Nullable for Job Cards created before
  // the field existed.
  departmentId String?

  complaint   String?       // legacy single-field complaint, kept for Job Cards created before per-item complaints existed — new Job Cards use `complaints` below instead
  diagnosis   String?       // technician/service-advisor findings, filled in after inspection
  mileageAtCheckIn Int?

  assignedTechnicianId String? // User.id — nullable until a technician is assigned
  // Separate from status/approvalStatus: being assigned is not the same as
  // accepting. Null when no technician is assigned; PENDING when assigned;
  // cleared on reassignment.
  technicianAcceptanceStatus   TechnicianAcceptanceStatus?
  technicianRespondedAt       DateTime?
  technicianRejectionReason   String? // required when the technician rejects, mirrors JobCard.rejectionReason's role for approval
  // The Workshop Supervisor of the resolved department. createJobCard checks
  // the chosen supervisor belongs to that department.
  supervisorId String?
  createdById String        // User.id — staff member who opened this Job Card

  status      JobCardStatus @default(CHECKED_IN)
  notes       String?

  // Separate from status: a Job Card can be CHECKED_IN and PENDING approval at
  // once. Status is where the vehicle is in the workflow; approval is whether
  // the supervisor has signed off.
  approvalStatus   JobCardApprovalStatus @default(PENDING)
  approvedById     String?   // User.id — who approved or rejected it
  approvedAt       DateTime? // when the current approvalStatus was set
  rejectionReason  String?   // short, required when rejecting — e.g. "Incomplete vehicle information"
  approvalNotes    String?   // optional longer commentary, on either an approval or a rejection

  closedAt    DateTime?
  // Set on entering READY_FOR_COLLECTION; anchors the collection grace period
  // (READY_FOR_COLLECTION_GRACE_WORKING_DAYS).
  readyForCollectionAt DateTime?
  // First time the Job Card reaches IN_PROGRESS (start of work). Not
  // overwritten when work resumes after AWAITING_PARTS.
  workStartedAt DateTime?
  // First time the Job Card reaches COMPLETED. With workStartedAt, measures
  // repair time, excluding the wait for collection.
  completedAt DateTime?
  // First time the Job Card reaches CHECKED_OUT: the vehicle left. This, not
  // closedAt, ends time in custody.
  checkedOutAt DateTime?
  // Name of whoever collected the vehicle (the customer or someone they
  // sent). Free text: collectors usually have no account.
  collectedByName String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  department         Department?         @relation(fields: [departmentId], references: [id])
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle            CustomerVehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  assignedTechnician User?               @relation("JobCardTechnician", fields: [assignedTechnicianId], references: [id])
  supervisor         User?               @relation("JobCardSupervisor", fields: [supervisorId], references: [id])
  approvedBy         User?               @relation("JobCardApprovedBy", fields: [approvedById], references: [id])
  createdBy          User                @relation("JobCardCreatedBy", fields: [createdById], references: [id])
  complaints         JobCardComplaint[]
  estimate           Estimate?
  payments           Payment[]
  refunds Refund[]
  cancellationRequests CancellationRequest[]
  closeRequests        CloseRequest[]
  partRequestSlips     PartRequestSlip[]
  externalProcurementRequests ExternalProcurementRequest[]
  // Reverse side of VehicleService.escalatedToJobCard.
  escalatedFromVehicleService VehicleService? @relation("VehicleServiceEscalatedJobCard")

  @@index([branchId, status])
  @@index([branchId, createdAt])
  @@index([customerId])
  @@index([vehicleId])
  @@index([assignedTechnicianId])
  @@index([supervisorId])
  @@map("job_cards")
  warranties Warranty[]
  warrantyClaims WarrantyClaim[]
  gateExit VehicleGateExit?
  roadTestPermits RoadTestPermit[]
}

// One row per reported issue on a Job Card (e.g. "Fan not working",
// "AC not working"). `sequenceNumber` keeps the order they were listed in.
model JobCardComplaint {
  id             String   @id @default(cuid())
  jobCardId      String
  jobCard        JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  sequenceNumber Int
  description    String
  createdAt      DateTime @default(now())

  @@map("job_card_complaints")
}

// One estimate per Job Card. `version` is reserved for estimate revisions
// and is not incremented yet.
// DRAFT: technician and supervisor build it; prices may be blank.
// SUBMITTED: sent to the supervisor; every line must be priced.
// APPROVED: supervisor sign-off; goes to the Workshop Manager.
// MANAGER_APPROVED: final; the customer can then be notified.
enum EstimateStatus {
  DRAFT
  SUBMITTED
  APPROVED
  MANAGER_APPROVED
}

model Estimate {
  id          String         @id @default(cuid())
  jobCardId   String         @unique
  status      EstimateStatus @default(DRAFT)
  version     Int            @default(1)
  submittedAt DateTime?
  approvedAt  DateTime?
  approvedById String?
  // Workshop Manager's sign-off. Managers cover a whole branch, so
  // eligibility is by branch (listEligibleManagersForBranch).
  managerApprovedAt   DateTime?
  managerApprovedById String?
  // Set when the customer is notified. Separate from MANAGER_APPROVED: the
  // Job Card's creator decides when to tell the customer
  // (notifyCustomerOfApprovedEstimate).
  customerNotifiedAt   DateTime?
  customerNotifiedById String?
  // When the approval reminder was last sent; prevents duplicate sends.
  reminderSentAt       DateTime?
  // When Store matching was requested. Store's queue shows only estimates with
  // this set, not every draft. Not cleared: Store Part lines added later
  // appear in the queue straight away.
  matchingRequestedAt   DateTime?
  matchingRequestedById String?
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  jobCard     JobCard            @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("EstimateCreatedBy", fields: [createdById], references: [id])
  approvedBy  User?              @relation("EstimateApprovedBy", fields: [approvedById], references: [id])
  managerApprovedBy User?        @relation("EstimateManagerApprovedBy", fields: [managerApprovedById], references: [id])
  customerNotifiedBy User?       @relation("EstimateCustomerNotifiedBy", fields: [customerNotifiedById], references: [id])
  matchingRequestedBy User?      @relation("EstimateMatchingRequestedBy", fields: [matchingRequestedById], references: [id])
  lineItems   EstimateLineItem[]

  @@map("estimates")
}

// Estimate line types, with who may price each (requirePricingAuthority):
//   STORE_PART    — a catalogue part; priced by Store matching.
//   EXTERNAL_PART — a part the technician bought outside; priced by the
//                   technician.
//   EXTERNAL_JOB  — work done outside (e.g. cylinder resurfacing, lathe
//                   work); priced by the technician.
//   INTERNAL_JOB  — named work done in the workshop (alignment, balancing,
//                   body work, AC gas, overhaul…); several allowed; priced
//                   by the supervisor.
//   LABOUR        — a labour charge for a piece of work ("Labour for
//                   Service", "Labour for Brake"); several allowed; priced
//                   by the supervisor.
//   SUNDRY        — small miscellaneous charges; one line per estimate
//                   (enforced in code); priced by the supervisor.
// `enteredById` records who entered each line.
enum EstimateLineItemType {
  STORE_PART
  EXTERNAL_PART
  EXTERNAL_JOB
  INTERNAL_JOB
  LABOUR
  SUNDRY
}

model EstimateLineItem {
  id          String               @id @default(cuid())
  estimateId  String
  type        EstimateLineItemType
  description String
  quantity    Int                  @default(1)
  // Nullable while DRAFT. `amount` is computed server-side once quantity and
  // unitPrice are both known.
  unitPrice   Decimal?             @db.Decimal(12, 2)
  amount      Decimal?             @db.Decimal(12, 2)
  enteredById String
  createdAt   DateTime             @default(now())
  // @default(now()) gives existing rows a value when the column is added;
  // @updatedAt alone has no database default.
  updatedAt   DateTime             @default(now()) @updatedAt
  // STORE_PART only: the part type the technician asked for, then the
  // catalogue part Store matched. Null until each step happens.
  partTypeId    String?
  matchedPartId String?
  // For STORE_PART, copied from the matched part's baseUnitOfMeasure; for
  // other lines, entered with the line.
  unitOfMeasure String?

  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  enteredBy   User     @relation(fields: [enteredById], references: [id])
  requestSlipLines PartRequestSlipLine[]
  externalProcurementRequests ExternalProcurementRequest[]
  // Per-line link used by multi-line requests; separate from the legacy
  // request-level relation above.
  externalProcurementRequestLines ExternalProcurementRequestLine[] @relation("ExternalProcurementRequestLineEstimate")
  partType    PartType? @relation(fields: [partTypeId], references: [id])
  matchedPart Part?     @relation("EstimateLineItemMatchedPart", fields: [matchedPartId], references: [id])

  @@index([estimateId])
  @@map("estimate_line_items")
  // Who pays for this line. CUSTOMER (default) counts towards what the
  // customer owes; WARRANTY lines are covered by a specific warranty (and
  // claimed from its provider); GOODWILL / INTERNAL are absorbed by the
  // business. Only the Warranty HOD / Branch Manager set it; audited.
  billTo             EstimateBillTo @default(CUSTOMER)
  coveringWarrantyId String?
  billToNote         String?
  coveringWarranty   Warranty?      @relation("EstimateLineCoveringWarranty", fields: [coveringWarrantyId], references: [id])
}

// Payments toward a Job Card's estimate (usually a deposit, then the
// balance), recorded by Finance from proof of a bank transfer or cash at
// the cashier: who recorded what, how much and how.
enum PaymentMethod {
  BANK_TRANSFER
  CASH
}

model Payment {
  id            String        @id @default(cuid())
  // Exactly one of jobCardId / vehicleServiceId is set (enforced in the app).
  jobCardId     String?
  vehicleServiceId String?
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  notes         String?       // e.g. a transfer reference or receipt number
  recordedById  String
  recordedAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  /// Operation id from the form — UNIQUE, so the same submission is never recorded twice.
  idempotencyKey String? @unique

  jobCard        JobCard?        @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  vehicleService VehicleService? @relation(fields: [vehicleServiceId], references: [id], onDelete: Cascade)
  recordedBy    User    @relation(fields: [recordedById], references: [id])

  @@index([jobCardId])
  @@index([vehicleServiceId])
  @@index([recordedAt])
  @@map("payments")
}

// Money returned to a customer, e.g. after a cancellation following a
// deposit. Recorded by Finance once a Manager has approved the
// cancellation. Never a negative Payment, so payments stay money in and
// each refund has its own receipt number. Exactly one of jobCardId /
// vehicleServiceId is set.
model Refund {
  id               String        @id @default(cuid())
  referenceNumber  String        @unique // RF-2026-000001
  jobCardId        String?
  vehicleServiceId String?
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod
  // Whoever physically received the money (cash) or the account holder (transfer).
  paidToName       String
  reason           String
  // Transfer reference, receipt number, or any other note.
  notes            String?
  recordedById     String
  recordedAt       DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
  /// Operation id from the form — UNIQUE, so the same submission is never recorded twice.
  idempotencyKey String? @unique

  jobCard        JobCard?        @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  vehicleService VehicleService? @relation(fields: [vehicleServiceId], references: [id], onDelete: Cascade)
  recordedBy     User            @relation("RefundRecordedBy", fields: [recordedById], references: [id])

  @@index([jobCardId])
  @@index([vehicleServiceId])
  @@map("refunds")
}

// A cancellation request does not change JobCard.status until a Manager
// approves it, so a decline has nothing to revert. A Job Card may have
// several requests over time. The requester's reason is required; the
// Manager's decision note is recorded either way.
enum CancellationRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

model CancellationRequest {
  id            String                    @id @default(cuid())
  jobCardId     String
  reason        String
  requestedById String
  requestedAt   DateTime                  @default(now())
  status        CancellationRequestStatus @default(PENDING)
  decidedById   String?
  decidedAt     DateTime?
  decisionNotes String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @default(now()) @updatedAt

  jobCard     JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("CancellationRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?   @relation("CancellationDecidedBy", fields: [decidedById], references: [id])

  @@index([jobCardId, status])
  @@map("cancellation_requests")
}

// Same request → Manager decision shape as CancellationRequest: status
// only becomes CLOSED on approval. No reason field (closing needs no
// justification).
model CloseRequest {
  id            String                    @id @default(cuid())
  jobCardId     String
  requestedById String
  requestedAt   DateTime                  @default(now())
  status        CancellationRequestStatus @default(PENDING)
  decidedById   String?
  decidedAt     DateTime?
  decisionNotes String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @default(now()) @updatedAt

  jobCard     JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("CloseRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?   @relation("CloseDecidedBy", fields: [decidedById], references: [id])

  @@index([jobCardId, status])
  @@map("close_requests")
}

// ----------------------------------------------------------------------------
// VEHICLE SERVICE: a lighter workflow than Job Card for routine maintenance
// and minor requested work (oil changes, filters, brake adjustment, AC gas).
// A repair found mid-service is escalated to a Job Card (escalatedToJobCardId).
// Uses the same Customer and CustomerVehicle records as Job Cards.
// ----------------------------------------------------------------------------

enum VehicleServiceStatus {
  SCHEDULED
  CHECKED_IN
  IN_SERVICE
  COMPLETED
  // Same end of life as a Job Card: work done → customer told it's ready
  // (with a collection-by date) → a Manager approves the close once paid →
  // checked out to a named collector (COLLECTED).
  READY_FOR_COLLECTION
  CLOSED
  COLLECTED
  CANCELLED
  // Handed over to a Job Card — terminal and read-only here; all work,
  // payment and checkout continue on the Job Card. The next-service
  // count starts when that Job Card is checked out.
  ESCALATED
}

// Service types are configurable data, not hard-coded names.
// intervalKm/intervalDays are nullable: a one-off request (e.g. "top up my AC
// gas") has no recurring interval, and produces no next-service prediction.
model VehicleService {
  id            String @id @default(cuid())
  serviceNumber String @unique // e.g. "SV-2026-000001", generated server-side; own sequence, separate from "JC-"
  branchId      String

  customerId String
  vehicleId  String

  status VehicleServiceStatus @default(SCHEDULED)

  // Odometer at this service, the basis of the next-service calculation.
  // Also written to CustomerVehicle.mileage, the same field Job Card check-in
  // updates.
  odometerAtService Int?

  // What the customer asked for, in their words ("adjust my brakes").
  // Legacy single-field complaint for services created before per-item
  // complaints; new services use `complaints` below.
  customerComplaint String?
  technicianNotes   String?

  assignedTechnicianId String?
  // Same as JobCard.technicianAcceptanceStatus: PENDING when assigned, null on
  // reassignment or rejection.
  technicianAcceptanceStatus TechnicianAcceptanceStatus?
  technicianRespondedAt      DateTime?
  technicianRejectionReason  String?

  // Set once, when work first starts: the manual move to IN_SERVICE or the
  // payment that crosses the 70% deposit, whichever comes first.
  workStartedAt DateTime?

  // Set by attendToOverdueVehicle: the due prediction has been handled and
  // leaves the Overdue list. A new completed service gives a new prediction.
  attendedAt DateTime?

  // Derived server-side from the vehicle's Passenger/Commercial type, never
  // from client input.
  departmentId String?
  // Required at creation: every visit has an accountable supervisor from the start.
  supervisorId String?

  approvalStatus   JobCardApprovalStatus @default(PENDING)
  approvedById     String?
  approvedAt       DateTime? // when the current approvalStatus was set
  rejectionReason  String?
  approvalNotes    String?

  // Set when a Job Card is created from this visit because the technician
  // found more than routine maintenance. The service stops progressing; the
  // Job Card takes over.
  escalatedToJobCardId String? @unique

  // Primary Service (engine oil, in practice), set when staff confirm it was
  // done on this visit. This explicit record anchors the vehicle's
  // next-service clock. Null means no Primary Service this visit.
  primaryServiceMileage Int?
  primaryServiceDate    DateTime?

  // Computed when primaryServiceMileage/Date are set, from the organisation's
  // interval. Null if no Primary Service this visit or no interval configured.
  nextServiceDueOdometer Int?
  nextServiceDueDate     DateTime?

  createdById String
  createdAt   DateTime  @default(now())
  checkedInAt DateTime?
  completedAt DateTime?
  // When the customer was told the vehicle is ready for collection.
  readyForCollectionAt DateTime?
  // When a Manager approved the close (see VehicleServiceCloseRequest).
  closedAt DateTime?
  // collectedAt is when the vehicle left (checked out); collectedByName is who
  // took it, required at checkout as for Job Cards.
  collectedAt DateTime?
  collectedByName String?
  cancelledAt DateTime?
  // When this service was handed over to a Job Card (status ESCALATED).
  escalatedAt DateTime?

  branch      Branch          @relation(fields: [branchId], references: [id])
  customer    Customer        @relation(fields: [customerId], references: [id])
  vehicle     CustomerVehicle @relation(fields: [vehicleId], references: [id])
  createdBy   User            @relation("VehicleServiceCreatedBy", fields: [createdById], references: [id])
  assignedTechnician User?    @relation("VehicleServiceTechnician", fields: [assignedTechnicianId], references: [id])
  department  Department?     @relation(fields: [departmentId], references: [id])
  supervisor  User?           @relation("VehicleServiceSupervisor", fields: [supervisorId], references: [id])
  approvedBy  User?           @relation("VehicleServiceApprovedBy", fields: [approvedById], references: [id])
  escalatedToJobCard JobCard? @relation("VehicleServiceEscalatedJobCard", fields: [escalatedToJobCardId], references: [id])

  complaints VehicleServiceComplaint[]
  inspection VehicleInspection?
  serviceEstimate ServiceEstimate?
  partRequestSlips PartRequestSlip[]
  payments Payment[]
  refunds Refund[]
  closeRequests VehicleServiceCloseRequest[]
  cancellationRequests VehicleServiceCancellationRequest[]

  @@index([branchId, status])
  @@index([branchId, createdAt])
  @@index([customerId])
  @@index([vehicleId])
  @@index([assignedTechnicianId])
  @@index([supervisorId])
  @@map("vehicle_services")
  warranties Warranty[]
  warrantyClaims WarrantyClaim[]
  gateExit VehicleGateExit?
  roadTestPermits RoadTestPermit[]
}

// Vehicle Service version of CloseRequest, kept separate from the Job Card
// flow. The creator or supervisor requests the close (once fully paid); a
// branch Manager approves (status → CLOSED) or declines.
model VehicleServiceCloseRequest {
  id               String                    @id @default(cuid())
  vehicleServiceId String
  requestedById    String
  requestedAt      DateTime                  @default(now())
  status           CancellationRequestStatus @default(PENDING)
  decidedById      String?
  decidedAt        DateTime?
  decisionNotes    String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @default(now()) @updatedAt

  vehicleService VehicleService @relation(fields: [vehicleServiceId], references: [id], onDelete: Cascade)
  requestedBy    User           @relation("VehicleServiceCloseRequestedBy", fields: [requestedById], references: [id])
  decidedBy      User?          @relation("VehicleServiceCloseDecidedBy", fields: [decidedById], references: [id])

  @@index([vehicleServiceId])
  @@map("vehicle_service_close_requests")
}

// Vehicle Service version of CancellationRequest: the creator or supervisor
// requests it with a reason (status unchanged); a branch Manager approves
// (→ CANCELLED, which also authorises a refund of anything paid) or declines.
model VehicleServiceCancellationRequest {
  id               String                    @id @default(cuid())
  vehicleServiceId String
  reason           String
  requestedById    String
  requestedAt      DateTime                  @default(now())
  status           CancellationRequestStatus @default(PENDING)
  decidedById      String?
  decidedAt        DateTime?
  decisionNotes    String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @default(now()) @updatedAt

  vehicleService VehicleService @relation(fields: [vehicleServiceId], references: [id], onDelete: Cascade)
  requestedBy    User           @relation("VehicleServiceCancellationRequestedBy", fields: [requestedById], references: [id])
  decidedBy      User?          @relation("VehicleServiceCancellationDecidedBy", fields: [decidedById], references: [id])

  @@index([vehicleServiceId])
  @@map("vehicle_service_cancellation_requests")
}

// One row per thing the customer asked for this visit ("AC not cooling
// well", "brake pedal feels soft"), like JobCardComplaint.
model VehicleServiceComplaint {
  id               String   @id @default(cuid())
  vehicleServiceId String
  vehicleService   VehicleService @relation(fields: [vehicleServiceId], references: [id], onDelete: Cascade)
  sequenceNumber   Int
  description      String
  createdAt        DateTime @default(now())

  @@map("vehicle_service_complaints")
}

// Every service-due reminder sent for a vehicle. Per vehicle, not per
// service, since a reminder is about the vehicle's next due point. The
// figures shown to the customer are stored as they were at send time,
// because mileage and predictions change afterwards.
model ServiceReminderLog {
  id                     String   @id @default(cuid())
  vehicleId              String
  vehicle                CustomerVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  // 1 = friendly, 2 = follow-up, 3 = due, 4+ = overdue. Stored rather than
  // derived from sentAt, since stages can be skipped or the interval changed.
  reminderNumber         Int
  sentAt                 DateTime @default(now())
  estimatedDueOdometer   Int?
  estimatedDueDate       DateTime?
  recordedOdometerAtSend Int?
  trigger                String
  deliveryStatus         String   @default("SENT")

  @@map("service_reminder_logs")
}

// One inspection per Vehicle Service: what was found. The service's
// status and notes record what was decided and done.
model VehicleInspection {
  id               String                  @id @default(cuid())
  vehicleServiceId String                  @unique
  inspectedById    String
  status           VehicleInspectionStatus @default(NOT_STARTED)
  startedAt        DateTime?
  completedAt      DateTime?
  // Set together on a skip; inspectedById is whoever decided to skip.
  skippedAt        DateTime?
  skipReason       String?
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  vehicleService VehicleService @relation(fields: [vehicleServiceId], references: [id], onDelete: Cascade)
  inspectedBy    User           @relation("VehicleInspectionInspector", fields: [inspectedById], references: [id])
  items          VehicleInspectionItem[]

  @@map("vehicle_inspections")
}

// One row per checklist item, generated from the vehicle-type template
// (lib/vehicle-inspection-template.ts) when the inspection starts.
// condition/action are free text because the vocabulary differs per item
// ("Dirty" filter, "Low" oil, "Worn" pad); severity is the controlled value
// used for summaries.
model VehicleInspectionItem {
  id           String              @id @default(cuid())
  inspectionId String
  section      String              // e.g. "Engine & Lubrication"
  name         String              // e.g. "Engine Oil"
  condition    String?
  severity     InspectionSeverity?
  action       String?
  notes        String?
  updatedAt    DateTime            @updatedAt

  inspection VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, section, name])
  @@map("vehicle_inspection_items")
}

enum ServiceEstimateStatus {
  DRAFT
  SUBMITTED
  APPROVED
  MANAGER_APPROVED
}

// Estimate for a Vehicle Service that did not need a Job Card. Same chain
// as a Job Card estimate: supervisor approves, Manager gives final
// sign-off, then the service's creator sends it to the customer. An
// escalated visit uses the Job Card's estimate instead; never both.
model ServiceEstimate {
  id               String                @id @default(cuid())
  vehicleServiceId String                @unique
  status           ServiceEstimateStatus @default(DRAFT)
  submittedAt      DateTime?
  approvedAt       DateTime?
  approvedById     String?
  // The Workshop Manager's sign-off, separate from the supervisor's
  // approvedAt/approvedById.
  managerApprovedAt   DateTime?
  managerApprovedById String?
  // Set when the estimate is sent to the customer. Never automatic: Manager
  // approval means the numbers are right, not that the customer should be
  // told yet.
  customerNotifiedAt   DateTime?
  customerNotifiedById String?
  // Set when the technician or supervisor asks Store to match the Store Part
  // lines (as on Job Card estimates).
  matchingRequestedAt   DateTime?
  matchingRequestedById String?
  createdById      String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  vehicleService VehicleService        @relation(fields: [vehicleServiceId], references: [id], onDelete: Cascade)
  createdBy      User                  @relation("ServiceEstimateCreatedBy", fields: [createdById], references: [id])
  approvedBy     User?                 @relation("ServiceEstimateApprovedBy", fields: [approvedById], references: [id])
  managerApprovedBy User?              @relation("ServiceEstimateManagerApprovedBy", fields: [managerApprovedById], references: [id])
  customerNotifiedBy User?             @relation("ServiceEstimateCustomerNotifiedBy", fields: [customerNotifiedById], references: [id])
  matchingRequestedBy User?            @relation("ServiceEstimateMatchingRequestedBy", fields: [matchingRequestedById], references: [id])
  lineItems      ServiceEstimateLineItem[]

  @@map("service_estimates")
}

// Two line types: STORE_PART goes through Store matching; everything else
// (outside parts, labour, sundry) is OTHER and priced by whoever enters it.
enum ServiceEstimateLineItemType {
  STORE_PART
  INTERNAL_JOB
  LABOUR
  SUNDRY
}

model ServiceEstimateLineItem {
  id           String                      @id @default(cuid())
  estimateId   String
  type         ServiceEstimateLineItemType
  description  String
  quantity     Decimal  @db.Decimal(10, 2)
  unitPrice    Decimal? @db.Decimal(12, 2)
  amount       Decimal? @db.Decimal(12, 2)
  enteredById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // STORE_PART only, as on Job Card estimates: the requester picks a part
  // type (e.g. "Engine Oil Filter"); Store matches a catalogue part, which
  // sets the price and unit. Both null for OTHER lines.
  partTypeId    String?
  matchedPartId String?
  unitOfMeasure String?

  estimate  ServiceEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  enteredBy User            @relation("ServiceEstimateLineEnteredBy", fields: [enteredById], references: [id])
  partType  PartType?       @relation(fields: [partTypeId], references: [id])
  matchedPart Part?         @relation(fields: [matchedPartId], references: [id])
  partRequestSlipLines PartRequestSlipLine[]

  @@index([estimateId])
  @@map("service_estimate_line_items")
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // v28: when it was added (audit trail and CRM ordering).
  createdAt  DateTime @default(now())

  label      String? // "Home", "Office"
  line1      String
  line2      String?
  city       String?
  state      String?
  country    String?

  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name  String
  phone String?
  email String?
  role  String? // e.g. "Fleet Manager"
  createdAt DateTime @default(now())

  @@index([customerId])
  @@map("customer_contacts")
}

// ----------------------------------------------------------------------------
// BETTER AUTH TABLES
// Standard Better Auth schema (https://www.better-auth.com/docs/concepts/database).
// Field names are set by the library's Prisma adapter; keep them in step with
// apps/portal/lib/auth.ts. Staff and customer sessions live in separate tables,
// so a customer token can never be presented to a staff-only guard.
// ----------------------------------------------------------------------------

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String    // "credential", "google", "microsoft"...
  password              String?   // password hash for the "credential" provider; Better Auth's field name, keep it
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@map("accounts")
}

model CustomerSession {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String   @unique
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("customer_sessions")
}

model CustomerAccount {
  id                    String    @id @default(cuid())
  customerId            String
  customer              Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  password              String?   // same field-name requirement as Account.password above
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@map("customer_accounts")
}

// Staff verification rows (email verification, password reset). Keyed by
// (identifier, value), not by user. Customer links use CustomerVerification.
model Verification {
  id         String   @id @default(cuid())
  identifier String   // typically the email being verified/reset
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  // v27: Better Auth writes updatedAt on every verification (password-reset
  // and set-password links), so the column is required.
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])

  @@map("verifications")
}

/// v28 — the customer portal's own reset / set-password links. Kept apart
/// from staff `verifications` so a customer link can never be redeemed on the
/// staff portal (or the reverse), whatever the token.
model CustomerVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("customer_verifications")
}

/// v28 CRM — a note staff keep on a customer (calls, preferences, follow-ups).
/// Never shown to the customer.
model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  authorId   String
  body       String
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User     @relation("CustomerNoteAuthor", fields: [authorId], references: [id])

  @@index([customerId, createdAt])
  @@map("customer_notes")
}

/// v28 — what a customer has read in their portal notifications
/// ("bc:<broadcastId>", "jc:<id>:<event>", …).
model CustomerNotificationRead {
  id         String   @id @default(cuid())
  customerId String
  key        String
  readAt     DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, key])
  @@map("customer_notification_reads")
}

// ----------------------------------------------------------------------------
// AUDIT LOG: append-only, timestamped history every module writes to.
// ----------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(cuid())
  // Which organisation's history this row belongs to (stamped on every
  // write — see audit-journal.ts). Null only for the platform team's own
  // or unattributed system rows, which only the platform team sees.
  organisationId String?
  userId     String?
  action     String   // e.g. "user.created", "job_card.approved"
  entityType String   // e.g. "JobCard"
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  // For the audit dashboard: a record's full history, a user's
  // activity, and date-range browsing — all indexed.
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  // The activity feed reads "this kind of record, newest first" and "this
  // person's actions, newest first".
  @@index([entityType, createdAt])
  @@index([userId, createdAt])
  // Each organisation's audit trail and activity feed, newest first.
  @@index([organisationId, createdAt])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// DASHBOARD ANNOUNCEMENTS: messages written by a Master Admin or Manager,
// shown in the dashboard marquee. Separate from AuditLog because they are
// authored messages, not recorded events.
// ----------------------------------------------------------------------------

model Announcement {
  id        String   @id @default(cuid())
  organisationId String
  message   String
  // After this the announcement stops showing (e.g. a notice about Friday's
  // stock count). Null means active until switched off.
  expiresAt DateTime?
  isActive  Boolean  @default(true)

  createdById String
  createdAt   DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])

  @@map("announcements")
}

// ----------------------------------------------------------------------------
// STORE / INVENTORY: part catalogue, units of measure, stock and goods
// receipts.
//
// Three tracking types (as in SAP's quantity / batch / serial split):
//   QUANTITY   — a single running total, e.g. brake pads, filters, WD-40.
//   BATCH      — stock grouped by delivery, e.g. engine oil, coolant, brake
//                fluid, so a bad batch can be traced to the vehicles that
//                received it without serialising every bottle.
//   SERIALIZED — each physical unit has its own identity, e.g. tyres, rims.
//
// Stock is held in one base unit (e.g. litres); a delivery can be recorded
// in the unit it arrived in (a drum, a case) and is converted.
// ----------------------------------------------------------------------------

enum PartTrackingType {
  QUANTITY
  BATCH
  SERIALIZED
}

enum PartSerialStatus {
  IN_STOCK
  ISSUED
}

model Part {
  id          String @id @default(cuid())
  branchId    String
  name        String
  description String?
  // Free-text browsing category used by the catalogue search. Structured
  // classification is partTypeId below.
  category    String?
  // Internal reference code. `barcode` below is reserved for barcode scanning.
  partNumber  String?
  barcode     String?
  trackingType PartTrackingType @default(QUANTITY)
  // The unit stock is held in (e.g. "Liter" for engine oil, "Each" for brake
  // pads). Alternative units convert to this one.
  baseUnitOfMeasure String
  // Reorder point and safety stock, set by Store (usually from the inventory
  // analytics suggestion).
  reorderPoint Decimal? @db.Decimal(12, 3)
  safetyStock  Decimal? @db.Decimal(12, 3)
  // Price charged to customers per base unit, set by Store. Separate from the
  // goods receipt cost (what was paid). Store matching requires it and never
  // falls back to cost.
  sellingPrice Decimal? @db.Decimal(12, 2)
  // The margin Store wants on this part, as a percentage of sellingPrice
  // (30 = cost at most 70% of price). Null means not set yet, not 0%; the
  // Pricing Command Center skips parts without one.
  targetMarginPercent Decimal? @db.Decimal(5, 2)
  // Whether the target is entered and shown as margin or markup.
  // targetMarginPercent always stores margin.
  pricingMethod PricingMethod @default(MARGIN)
  isActive     Boolean  @default(true)
  // The generic part type this part is (e.g. "Fuel Filter"), so a technician's
  // request for a type can match every vehicle-specific part of that type.
  // Separate from the free-text `category` browsing field.
  partTypeId   String?
  // Warranty issued with this part on release to a customer (null = none).
  // Set on the Part page.
  warrantyPolicyId String?
  // The part's number in another system (v-A0): externalSource SAP and
  // externalId the material number (MATNR). Unique per branch and source.
  externalSource String?
  externalId     String?
  // The import that created this part (Data Exchange, v-A2): Undo moves exactly these to the Recycle bin.
  importJobId    String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User     @relation("PartCreatedBy", fields: [createdById], references: [id])
  partType  PartType? @relation(fields: [partTypeId], references: [id])
  warrantyPolicy WarrantyPolicy? @relation(fields: [warrantyPolicyId], references: [id])
  warranties Warranty[]

  alternativeUnits  PartUnitOfMeasure[]
  stock             PartStock?
  batches           PartBatch[]
  serials           PartSerial[]
  goodsReceiptLines GoodsReceiptLine[]
  requestSlipLines  PartRequestSlipLine[]
  // Release trail for QUANTITY parts (which request took how much).
  quantityConsumptions PartQuantityConsumption[]
  fitments          PartFitment[]
  matchedOnEstimateLines EstimateLineItem[] @relation("EstimateLineItemMatchedPart")
  matchedOnServiceEstimateLines ServiceEstimateLineItem[]
  pricingAlerts     PricingAlert[]

  @@unique([branchId, partNumber])
  @@unique([branchId, externalSource, externalId])
  @@index([externalId])
  @@index([importJobId])
  @@map("parts")
}

// An alternative unit a delivery may arrive in and its factor to the base
// unit, e.g. "Drum" with conversionFactor 200 for a part in litres.
model PartUnitOfMeasure {
  id               String  @id @default(cuid())
  partId           String
  unitName         String
  conversionFactor Decimal @db.Decimal(12, 4)

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([partId, unitName])
  @@map("part_units_of_measure")
}

// The current stock total for a part: the stock figure for QUANTITY parts,
// and a running total for BATCH/SERIALIZED parts (detail in PartBatch /
// PartSerial) so nothing has to sum batches or serials.
model PartStock {
  id               String   @id @default(cuid())
  partId           String   @unique
  quantityOnHand   Decimal  @default(0) @db.Decimal(14, 4)
  // Quantity reserved by approved parts requests, so a later request can't be
  // promised the same stock before the first is released.
  quantityReserved Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt        DateTime @updatedAt

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@map("part_stock")
}

// One row per delivery batch of a BATCH part, e.g. "one 200 L drum received
// on 2026-08-29, 152 L left". remainingQuantity goes down on release;
// receivedQuantity never changes.
model PartBatch {
  id                 String    @id @default(cuid())
  partId             String
  batchNumber        String
  receivedQuantity   Decimal   @db.Decimal(14, 4)
  remainingQuantity  Decimal   @db.Decimal(14, 4)
  receivedAt         DateTime  @default(now())
  expiryDate         DateTime?
  goodsReceiptLineId String?

  part             Part              @relation(fields: [partId], references: [id], onDelete: Cascade)
  goodsReceiptLine GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id])
  // Draws against this batch. Many-to-many: a release can draw from several
  // batches (FIFO) and a batch can serve several releases.
  consumptions     PartBatchConsumption[]

  @@unique([partId, batchNumber])
  @@map("part_batches")
}

// Which batch a released quantity came from, so a warranty or defect trace
// can find the customers who received stock from a delivery.
model PartBatchConsumption {
  id            String   @id @default(cuid())
  batchId       String
  slipLineId    String
  quantityTaken Decimal  @db.Decimal(14, 4)
  consumedAt    DateTime @default(now())

  batch    PartBatch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  slipLine PartRequestSlipLine @relation(fields: [slipLineId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([slipLineId])
  @@index([consumedAt])
  @@map("part_batch_consumptions")
}

// Release trail for QUANTITY parts (no batch or serial rows): which
// request took how much.
model PartQuantityConsumption {
  id            String   @id @default(cuid())
  partId        String
  slipLineId    String
  quantityTaken Decimal  @db.Decimal(14, 4)
  consumedAt    DateTime @default(now())
  // The goods receipt line this release drew from, so QUANTITY releases trace
  // back to a GRN like batches and serials. A release spanning two deliveries
  // is two rows, FIFO (lib/inventory/quantity-fifo.ts). Null on older
  // releases, which are attributed oldest-first at display time.
  goodsReceiptLineId String?

  part             Part                @relation(fields: [partId], references: [id], onDelete: Cascade)
  slipLine         PartRequestSlipLine @relation(fields: [slipLineId], references: [id], onDelete: Cascade)
  goodsReceiptLine GoodsReceiptLine?   @relation(fields: [goodsReceiptLineId], references: [id])

  @@index([partId])
  @@index([goodsReceiptLineId])
  @@index([slipLineId])
  @@index([consumedAt])
  @@map("part_quantity_consumptions")
}

// One row per physical unit of a SERIALIZED part (e.g. one tyre). status
// becomes ISSUED on release; serials are never deleted.
model PartSerial {
  id                 String           @id @default(cuid())
  partId             String
  serialNumber       String
  status             PartSerialStatus @default(IN_STOCK)
  receivedAt         DateTime         @default(now())
  goodsReceiptLineId String?
  // The request line this unit was issued against, for warranty traces. A
  // single link is enough because a unit is issued once (there is no
  // returns flow).
  issuedToSlipLineId String?

  part             Part                 @relation(fields: [partId], references: [id], onDelete: Cascade)
  goodsReceiptLine GoodsReceiptLine?    @relation(fields: [goodsReceiptLineId], references: [id])
  issuedToSlipLine PartRequestSlipLine? @relation(fields: [issuedToSlipLineId], references: [id])

  // Unique across all parts, not per part: a serial identifies one physical
  // unit in the whole catalogue.
  @@unique([serialNumber])
  @@index([partId, status])
  @@index([issuedToSlipLineId])
  @@index([goodsReceiptLineId])
  @@map("part_serials")
  warranties Warranty[]
}

// A delivery into the store. Numbered GRN-2026-000001, like Job Card numbers.
model GoodsReceipt {
  id              String   @id @default(cuid())
  // One per submitted form (see components/IdempotencyKey.tsx): the same
  // delivery resent after a dropped connection can never add stock twice.
  idempotencyKey  String?  @unique
  branchId        String
  referenceNumber String   @unique
  supplierName    String
  // v-A2: the supplier from the organisation's supplier list, when the name matches one (the name stays as typed).
  supplierId      String?
  receivedById    String
  receivedAt      DateTime @default(now())
  notes           String?
  // v-A2: the stock a branch already held when it started with EJO, brought in by an import (Data Exchange):
  // an opening-balance receipt dated at the cut-over, so FIFO costs, stock value and the inventory analytics
  // include it like any delivery. importJobId: the import that made it (its reversal removes exactly these).
  isOpeningBalance Boolean @default(false)
  importJobId     String?
  createdAt       DateTime @default(now())

  supplier   Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  receivedBy User               @relation("GoodsReceiptReceivedBy", fields: [receivedById], references: [id])
  lines      GoodsReceiptLine[]

  @@index([branchId, receivedAt])
  @@index([importJobId])
  @@index([supplierId])
  @@map("goods_receipts")
  gateDeliveries GateDelivery[]
}

// One line per part on a delivery. quantityReceivedInUnit and unitUsed are
// what the storekeeper entered (e.g. "1 Drum"); quantityInBaseUnit is what
// was added to stock (e.g. "200 Liters"). Both are kept.
model GoodsReceiptLine {
  id                     String   @id @default(cuid())
  goodsReceiptId         String
  partId                 String
  quantityReceivedInUnit Decimal  @db.Decimal(14, 4)
  unitUsed               String
  quantityInBaseUnit     Decimal  @db.Decimal(14, 4)
  // Exact amount paid for the delivery line, from the typed figures. Never
  // recomputed from unitCost: ₦650,000 ÷ 205 L has no exact 2-decimal answer,
  // and multiplying the rounded unit cost back out shows ₦649,999.65.
  totalCost              Decimal? @db.Decimal(14, 2)
  // Cost per base unit, for pricing calculations and "₦X/Liter" notes.
  // Derived, not the record of what was paid. Six decimal places keep
  // rounding errors below a kobo.
  unitCost               Decimal? @db.Decimal(16, 6)
  // Only meaningful for a BATCH-tracked part — the batch this line
  // creates or adds to.
  batchNumber            String?

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  part         Part         @relation(fields: [partId], references: [id])
  batches      PartBatch[]
  serials      PartSerial[]
  quantityConsumptions PartQuantityConsumption[]
  pricingAlert PricingAlert?

  @@index([goodsReceiptId])
  @@index([partId])
  @@map("goods_receipt_lines")
}

// ----------------------------------------------------------------------------
// PRICING COMMAND CENTER: each goods receipt line for a part with both a
// sellingPrice and a targetMarginPercent is compared against the new cost
// when it is recorded (recordGoodsReceipt). Parts missing either are skipped.
// ----------------------------------------------------------------------------

// How the target is entered and shown. Part.targetMarginPercent always
// stores margin (profit ÷ selling price); a part priced by markup
// (profit ÷ cost) shows and accepts markup, converted both ways. Typing a
// markup figure into a margin field would ask for a higher target.
enum PricingMethod {
  MARGIN
  MARKUP
}

enum PricingAlertSeverity {
  // Margin is below target but still positive.
  DEFICIT
  // Cost has fallen; margin is now well above target. An opportunity, flagged
  // so it isn't missed.
  BOOST
  // Cost exceeds sellingPrice: every sale loses money. Store matching refuses
  // the part while this alert is open.
  CRITICAL_LOSS
}

enum PricingAlertStatus {
  OPEN
  // Store changed sellingPrice (or the target) in response, e.g. via "Sync
  // Price". DISMISSED means the current price was kept on purpose.
  RESOLVED
  DISMISSED
}

model PricingAlert {
  id       String @id @default(cuid())
  partId   String
  // The delivery that raised this alert.
  goodsReceiptLineId String @unique
  severity PricingAlertSeverity
  status   PricingAlertStatus @default(OPEN)

  // Figures as they were when the alert was raised, since sellingPrice and
  // the target may change later.
  previousUnitCost   Decimal? @db.Decimal(16, 6)
  newUnitCost        Decimal @db.Decimal(16, 6)
  sellingPriceAtAlert Decimal @db.Decimal(12, 2)
  targetMarginPercentAtAlert Decimal @db.Decimal(5, 2)
  actualMarginPercent Decimal @db.Decimal(6, 2)

  resolvedById String?
  resolvedAt   DateTime?
  resolutionNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  part            Part             @relation(fields: [partId], references: [id], onDelete: Cascade)
  goodsReceiptLine GoodsReceiptLine @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Cascade)
  resolvedBy      User?            @relation("PricingAlertResolvedBy", fields: [resolvedById], references: [id])

  @@index([partId, status])
  @@map("pricing_alerts")
}

// ----------------------------------------------------------------------------
// PARTS REQUEST SLIP & EXTERNAL PROCUREMENT: the two sourcing paths for an
// estimate, chosen from its line types (STORE_PART vs EXTERNAL_PART /
// EXTERNAL_JOB). A job may need one, both or neither.
// Both open once the job reaches IN_PROGRESS (deposit paid).
// ----------------------------------------------------------------------------

enum PartRequestSlipStatus {
  PENDING_HOD_APPROVAL
  PENDING_STORE_APPROVAL
  APPROVED
  RELEASED
  REJECTED
}

enum ExternalProcurementStatus {
  // First stage: Finance reviews and may add supplementary costs (transport,
  // logistics) before the Manager sees it, without changing the technician's
  // figures. Requests created before this stage existed continue from
  // PENDING_MANAGER_APPROVAL.
  PENDING_FINANCE_REVIEW
  PENDING_MANAGER_APPROVAL
  APPROVED
  DISBURSED
  REJECTED
}

// Store parts: the Workshop HOD approves the request, Store approves and
// reserves the stock (PartStock.quantityReserved, so a later request can't
// be promised the same units), and a storekeeper releases it.
// Numbered PRS-2026-000001.
model PartRequestSlip {
  id              String                @id @default(cuid())
  referenceNumber String                @unique
  // Exactly one of jobCardId / vehicleServiceId is set, enforced in the app
  // (Prisma can't express a CHECK constraint).
  jobCardId       String?
  vehicleServiceId String?
  branchId        String
  requestedById   String
  status          PartRequestSlipStatus @default(PENDING_HOD_APPROVAL)

  hodApprovedById String?
  hodApprovedAt   DateTime?
  hodNotes        String?

  storeApprovedById String?
  storeApprovedAt   DateTime?
  storeNotes        String?

  releasedById String?
  releasedAt   DateTime?
  // Who collected the parts: a user where possible, or a typed name (e.g. an
  // intern without an account). One collector per slip.
  receivedByUserId String?
  receivedByName   String?

  rejectedById    String?
  rejectedAt      DateTime?
  // HOD or STORE: which stage rejected it, stated rather than inferred from
  // timestamps.
  rejectionStage  String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  jobCard        JobCard?  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  vehicleService VehicleService? @relation(fields: [vehicleServiceId], references: [id], onDelete: Cascade)
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  requestedBy    User     @relation("PartRequestSlipRequestedBy", fields: [requestedById], references: [id])
  hodApprovedBy  User?    @relation("PartRequestSlipHodApprovedBy", fields: [hodApprovedById], references: [id])
  storeApprovedBy User?   @relation("PartRequestSlipStoreApprovedBy", fields: [storeApprovedById], references: [id])
  releasedBy     User?    @relation("PartRequestSlipReleasedBy", fields: [releasedById], references: [id])
  receivedByUser User?    @relation("PartRequestSlipReceivedBy", fields: [receivedByUserId], references: [id])
  rejectedBy     User?    @relation("PartRequestSlipRejectedBy", fields: [rejectedById], references: [id])
  lines          PartRequestSlipLine[]

  @@index([branchId, status])
  @@index([jobCardId])
  @@index([vehicleServiceId])
  @@map("part_request_slips")
}

model PartRequestSlipLine {
  id                 String   @id @default(cuid())
  slipId             String
  partId             String
  // The Job Card estimate line this line sources.
  estimateLineItemId String?
  // The Service Estimate line this line sources. Never set together with
  // estimateLineItemId.
  serviceEstimateLineItemId String?
  // In the part's base unit; reservation and release use the base unit.
  quantityRequested  Decimal  @db.Decimal(14, 4)
  quantityReleased   Decimal? @db.Decimal(14, 4)

  slip             PartRequestSlip   @relation(fields: [slipId], references: [id], onDelete: Cascade)
  part             Part              @relation(fields: [partId], references: [id])
  estimateLineItem EstimateLineItem? @relation(fields: [estimateLineItemId], references: [id])
  serviceEstimateLineItem ServiceEstimateLineItem? @relation(fields: [serviceEstimateLineItemId], references: [id])
  // What this line was released with: batch quantities and serials.
  batchConsumptions PartBatchConsumption[]
  issuedSerials     PartSerial[]
  quantityConsumptions PartQuantityConsumption[]

  @@index([slipId])
  @@index([partId])
  @@map("part_request_slip_lines")
  warranties Warranty[]
}

// External parts/jobs: a cash advance (imprest). The technician requests
// money for a purchase, Finance reviews, a Manager approves, Finance pays
// out. retiredById/retiredAt are reserved for reconciling the advance
// against a receipt, which needs file attachments (not built yet).
model ExternalProcurementRequest {
  id                 String                     @id @default(cuid())
  referenceNumber    String                     @unique
  jobCardId          String
  branchId           String
  // Legacy single-line fields, kept for requests raised before multi-line
  // support. New requests use `lines` below.
  estimateLineItemId String?
  requestedById      String
  description        String
  // The technician's figure, fixed at submission (no edit path). For a
  // multi-line request, the sum of its lines. Finance's additions and the
  // approval build on it.
  estimatedAmount    Decimal                    @db.Decimal(12, 2)
  status             ExternalProcurementStatus  @default(PENDING_FINANCE_REVIEW)

  // estimatedAmount plus all supplementary lines, fixed at Manager approval,
  // so nothing added later changes what was approved.
  approvedTotal Decimal? @db.Decimal(12, 2)

  financeReviewedById String?
  financeReviewedAt   DateTime?

  managerApprovedById String?
  managerApprovedAt   DateTime?
  managerNotes        String?

  disbursedById     String?
  disbursedAt       DateTime?
  // Amount paid out: copied from approvedTotal at disbursement, never typed.
  // Stored as the historical record of what was disbursed.
  disbursedAmount   Decimal? @db.Decimal(12, 2)
  // e.g. "Cash", "Transfer" (suggested list, free text allowed). Set at
  // disbursement together with the fields below.
  paymentMethod     String?
  // Bank transaction reference; none for cash.
  paymentReference  String?
  disbursementNotes String?

  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?
  // FINANCE_REVIEW or MANAGER_APPROVAL: where the request was rejected.
  rejectionStage  String?

  retiredById String?
  retiredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  jobCard          JobCard           @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  estimateLineItem EstimateLineItem? @relation(fields: [estimateLineItemId], references: [id])
  requestedBy      User              @relation("ExternalProcurementRequestedBy", fields: [requestedById], references: [id])
  financeReviewedBy User?            @relation("ExternalProcurementFinanceReviewedBy", fields: [financeReviewedById], references: [id])
  managerApprovedBy User?            @relation("ExternalProcurementManagerApprovedBy", fields: [managerApprovedById], references: [id])
  disbursedBy      User?             @relation("ExternalProcurementDisbursedBy", fields: [disbursedById], references: [id])
  rejectedBy       User?             @relation("ExternalProcurementRejectedBy", fields: [rejectedById], references: [id])
  retiredBy        User?             @relation("ExternalProcurementRetiredBy", fields: [retiredById], references: [id])
  supplementaryLines ExternalProcurementSupplementaryLine[]
  // One row per External Part/Job estimate line (same shape as
  // PartRequestSlipLine). Legacy single-line requests have none.
  lines              ExternalProcurementRequestLine[]

  @@index([branchId, status])
  @@index([jobCardId])
  @@map("external_procurement_requests")
}

// One item on an External Procurement Request, so several outside items for
// one repair (e.g. a lathe job and a bushing) go to Finance as one request.
model ExternalProcurementRequestLine {
  id                 String   @id @default(cuid())
  requestId          String
  estimateLineItemId String?
  description        String
  quantity           Decimal  @db.Decimal(14, 4)
  unitOfMeasure      String?
  amount             Decimal  @db.Decimal(12, 2)

  request          ExternalProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  estimateLineItem EstimateLineItem?          @relation("ExternalProcurementRequestLineEstimate", fields: [estimateLineItemId], references: [id])

  @@map("external_procurement_request_lines")
}

// Costs Finance adds (transport, logistics…). A row per cost, with who added
// it and when, so the technician's original request is never edited.
model ExternalProcurementSupplementaryLine {
  id          String   @id @default(cuid())
  requestId   String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  addedById   String
  createdAt   DateTime @default(now())

  request ExternalProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  addedBy User                       @relation("ExternalProcurementSupplementaryLineAddedBy", fields: [addedById], references: [id])

  @@map("external_procurement_supplementary_lines")
}

// ----------------------------------------------------------------------------
// PART FITMENT: which vehicles a part fits. The compatibility key is the
// engine, not the model name: different models can share an engine (Isuzu
// NPR and NQR both use the 4HK1) and one model name can hide different
// engines. A many-to-many table expresses "fits two models but not a third".
//
// A part with no fitment rows fits everything (engine oil, coolant, brake
// fluid…).
// ----------------------------------------------------------------------------

model PartFitment {
  id     String @id @default(cuid())
  partId String
  make   String
  // Null means "fits every model of this make".
  model  String?
  // Null means "fits every engine of this make/model". Only set together
  // with model.
  engineType String?
  // Optional year range; null on either end means unbounded. Only set
  // together with model.
  yearFrom Int?
  yearTo   Int?

  createdAt DateTime @default(now())

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@map("part_fitments")
}

// ----------------------------------------------------------------------------
// PART CATEGORY / PART TYPE: the two-level list technicians browse when
// writing an estimate:
//
//   Filter (PartCategory)              Fluid (PartCategory)
//   ├── Oil Filter (PartType)          ├── Coolant (PartType)
//   └── Fuel Filter (PartType)         ├── Engine Oil (PartType)
//                                      └── Brake Fluid (PartType)
//
// The PartType ("Fuel Filter") is what appears on the estimate. One type can
// cover several vehicle-specific Parts ("Fuel Filter — Foton Tunland",
// "Fuel Filter — Foton TM3"); Store picks the one that fits.
// Separate from the free-text Part.category browsing field.
// ----------------------------------------------------------------------------

model PartCategory {
  id          String   @id @default(cuid())
  branchId    String
  name        String
  // Prefix for generated part numbers (e.g. "FIL" → FIL-001). Nullable for
  // older categories; required by the create form.
  code        String?
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User   @relation("PartCategoryCreatedBy", fields: [createdById], references: [id])

  partTypes PartType[]

  @@unique([branchId, name])
  @@unique([branchId, code])
  @@map("part_categories")
}

model PartType {
  id          String   @id @default(cuid())
  branchId    String
  categoryId  String
  name        String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category  PartCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy User         @relation("PartTypeCreatedBy", fields: [createdById], references: [id])

  parts             Part[]
  estimateLineItems EstimateLineItem[]
  serviceEstimateLineItems ServiceEstimateLineItem[]

  @@unique([branchId, categoryId, name])
  @@map("part_types")
}

// ─────────────────────────────────────────────────────────────────────────
// WARRANTY — a generic, industry-neutral core. An ASSET warranty covers a
// whole product a customer owns (in automotive: a vehicle); a PART
// warranty covers one component issued to that customer's asset. Brands,
// providers and terms are data (WarrantyProvider / WarrantyPolicy), never
// code — so Foton, Isuzu or a different industry is configuration.
// ─────────────────────────────────────────────────────────────────────────

enum WarrantyKind {
  ASSET
  PART
}

// PENDING_VERIFICATION → ACTIVE (a second person verifies a manually
// registered warranty); SUSPENDED / VOID / TRANSFERRED are deliberate
// decisions with a reason. "Expired" is computed from dates and distance,
// never stored — so it can never be wrong or stale.
enum WarrantyStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  VOID
  TRANSFERRED
}

enum WarrantyProviderType {
  MANUFACTURER
  DISTRIBUTOR
  COMPONENT_MAKER
  SUPPLIER
  INTERNAL
}

// Who stands behind a warranty (and who a claim is recovered from).
model WarrantyProvider {
  id                  String               @id @default(cuid())
  name                String               @unique
  type                WarrantyProviderType
  contactName         String?
  email               String?
  phone               String?
  // Days allowed to submit a claim after the repair, and to retain a
  // failed part after submission — used by claim deadlines later.
  claimSubmissionDays Int?
  partRetentionDays   Int?
  notes               String?
  // The organisation that keeps this record (each organisation has its own
  // providers and policies). Null only on rows created before multi-org.
  organisationId String?
  isActive            Boolean              @default(true)
  // Deletion approved while in use (policies, warranties or claims) →
  // archived, never erased: history stays valid and traceable.
  archivedAt          DateTime?
  archivedReason      String?
  createdById         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now()) @updatedAt

  createdBy  User             @relation("WarrantyProviderCreatedBy", fields: [createdById], references: [id])
  deletionRequests WarrantyProviderDeletionRequest[]
  policies   WarrantyPolicy[]
  warranties Warranty[]

  claims WarrantyClaim[]

  @@index([organisationId])
  @@map("warranty_providers")
}

// What a provider promises: duration, distance ("whichever comes first"),
// what's covered and excluded, and the conditions (e.g. keep scheduled
// servicing). ASSET policies apply to a brand/model; PART policies are
// attached to parts in Inventory.
model WarrantyPolicy {
  id               String       @id @default(cuid())
  code             String       @unique
  name             String
  kind             WarrantyKind
  providerId       String
  brand            String?
  model            String?
  // The duration amount in durationUnit. Named durationMonths because it was
  // always months before durationUnit existed.
  durationMonths   Int
  durationUnit     WarrantyDurationUnit @default(MONTHS)
  // Distance limit from the start reading (km in automotive); null = unlimited.
  distanceLimit    Int?
  coverageSummary  String
  exclusions       String?
  conditions       String?
  // What the provider pays for, and how they normally make it right.
  coversParts      Boolean        @default(true)
  coversLabour     Boolean        @default(true)
  // Freight: shipping the replacement in and the failed part back.
  coversLogistics  Boolean        @default(false)
  defaultRemedy    WarrantyRemedy @default(REIMBURSEMENT)
  // Sample terms for demonstration, flagged everywhere until real terms
  // replace them.
  isSample         Boolean      @default(false)
  // The organisation that keeps this record (each organisation has its own
  // providers and policies). Null only on rows created before multi-org.
  organisationId String?
  isActive         Boolean      @default(true)
  // A policy whose deletion was approved but that already issued
  // warranties is ARCHIVED, never erased — its certificates and history
  // stay valid and traceable; it just can't be used again.
  archivedAt       DateTime?
  archivedReason   String?
  createdById      String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt

  provider   WarrantyProvider @relation(fields: [providerId], references: [id])
  createdBy  User             @relation("WarrantyPolicyCreatedBy", fields: [createdById], references: [id])
  warranties Warranty[]
  parts      Part[]
  deletionRequests WarrantyPolicyDeletionRequest[]

  @@index([organisationId])
  @@map("warranty_policies")
}

// One warranty = one number (WR-2026-000001), one certificate. Terms are
// snapshotted at issue so a later policy edit never rewrites history.
model Warranty {
  id                  String         @id @default(cuid())
  warrantyNumber      String         @unique
  kind                WarrantyKind
  status              WarrantyStatus @default(ACTIVE)
  policyId            String
  providerId          String
  customerId          String
  vehicleId           String?
  partId              String?
  partSerialId        String?
  slipLineId          String?
  jobCardId           String?
  vehicleServiceId    String?
  // What is covered, in words (snapshot): "Foton TM3 — VIN …" or
  // "Alternator (ALT-001) — serial SN-123".
  subjectDescription  String
  quantity            Decimal?       @db.Decimal(14, 4)
  startsAt            DateTime
  endsAt              DateTime
  startReading        Int?
  distanceLimit       Int?
  coverageSnapshot    String
  exclusionsSnapshot  String?
  conditionsSnapshot  String?
  // AUTO (issued on a part release) or MANUAL (registered by staff, e.g. a
  // vehicle sold before the system was in use).
  origin              String
  evidenceNote        String?
  issuedById          String?
  issuedAt            DateTime       @default(now())
  verifiedById        String?
  verifiedAt          DateTime?
  statusReason        String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @default(now()) @updatedAt

  policy         WarrantyPolicy       @relation(fields: [policyId], references: [id])
  provider       WarrantyProvider     @relation(fields: [providerId], references: [id])
  customer       Customer             @relation(fields: [customerId], references: [id])
  vehicle        CustomerVehicle?     @relation(fields: [vehicleId], references: [id])
  part           Part?                @relation(fields: [partId], references: [id])
  partSerial     PartSerial?          @relation(fields: [partSerialId], references: [id])
  slipLine       PartRequestSlipLine? @relation(fields: [slipLineId], references: [id])
  jobCard        JobCard?             @relation(fields: [jobCardId], references: [id])
  vehicleService VehicleService?      @relation(fields: [vehicleServiceId], references: [id])
  issuedBy       User?                @relation("WarrantyIssuedBy", fields: [issuedById], references: [id])
  verifiedBy     User?                @relation("WarrantyVerifiedBy", fields: [verifiedById], references: [id])

  @@index([customerId])
  @@index([vehicleId])
  @@index([jobCardId])
  @@index([vehicleServiceId])
  @@index([slipLineId])
  @@index([endsAt])
  @@map("warranties")
  claims WarrantyClaim[]
  coveredEstimateLines EstimateLineItem[] @relation("EstimateLineCoveringWarranty")
}

// The branch chain for warranty decisions: Warranty staff request →
// Warranty HOD approves → Branch Manager approves. Nobody approves their
// own request.
enum WarrantyApprovalStatus {
  PENDING_HOD
  PENDING_MANAGER
  APPROVED
  DECLINED
}

// Deleting a policy goes through the chain. On final approval a policy
// that never issued a warranty is deleted; one that did is archived.
model WarrantyPolicyDeletionRequest {
  id              String                 @id @default(cuid())
  // Null once the policy itself has been deleted (code/name are kept).
  policyId        String?
  reason          String
  status          WarrantyApprovalStatus @default(PENDING_HOD)
  requestedById   String
  requestedAt     DateTime               @default(now())
  hodDecidedById  String?
  hodDecidedAt    DateTime?
  managerDecidedById String?
  managerDecidedAt   DateTime?
  declineReason   String?
  // What final approval did: DELETED or ARCHIVED.
  outcome         String?
  // Kept after the policy itself is deleted.
  policyCode      String
  policyName      String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @default(now()) @updatedAt

  policy         WarrantyPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  requestedBy    User            @relation("WarrantyPolicyDeletionRequestedBy", fields: [requestedById], references: [id])
  hodDecidedBy   User?           @relation("WarrantyPolicyDeletionHodDecidedBy", fields: [hodDecidedById], references: [id])
  managerDecidedBy User?         @relation("WarrantyPolicyDeletionManagerDecidedBy", fields: [managerDecidedById], references: [id])

  @@index([policyId])
  @@index([status])
  @@map("warranty_policy_deletion_requests")
}

// A warranty claim: the "3 C's" (complaint, cause, correction), the
// causal part, the failure (date and reading), the money claimed, and a
// lifecycle through the branch chain and the provider:
// DRAFT → PENDING_HOD → PENDING_MANAGER → APPROVED_TO_SUBMIT → SUBMITTED
//   → ACCEPTED / PARTIALLY_ACCEPTED / REJECTED → SETTLED.
// Sent back (to DRAFT) with a reason at any approval step; a rejected
// claim can be reopened for resubmission; CANCELLED before submission.
enum WarrantyClaimStatus {
  DRAFT
  PENDING_HOD
  PENDING_MANAGER
  APPROVED_TO_SUBMIT
  SUBMITTED
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
  SETTLED
  CANCELLED
}

model WarrantyClaim {
  id                String              @id @default(cuid())
  claimNumber       String              @unique
  status            WarrantyClaimStatus @default(DRAFT)
  warrantyId        String
  providerId        String
  customerId        String
  vehicleId         String?
  jobCardId         String?
  vehicleServiceId  String?
  complaint         String
  cause             String
  correction        String
  causalPart        String
  causalPartNumber  String?
  failureDate       DateTime
  failureReading    Int?
  labourAmount      Decimal             @default(0) @db.Decimal(12, 2)
  partsAmount       Decimal             @default(0) @db.Decimal(12, 2)
  otherAmount       Decimal             @default(0) @db.Decimal(12, 2)
  // Freight / courier for the replacement and the failed-part return.
  logisticsAmount   Decimal             @default(0) @db.Decimal(12, 2)
  claimedAmount     Decimal             @default(0) @db.Decimal(12, 2)
  approvedAmount    Decimal?            @db.Decimal(12, 2)
  settledAmount     Decimal?            @db.Decimal(12, 2)
  // From the provider's claim rules at the time the claim was opened.
  deadlineAt        DateTime?
  providerReference String?
  settlementReference String?
  decisionNotes     String?
  returnReason      String?
  cancelReason      String?
  resubmissionCount Int                 @default(0)
  // How the provider makes it right: pay/credit, send a replacement part,
  // or repair the failed part and return it.
  remedy            WarrantyRemedy      @default(REIMBURSEMENT)
  // Failed-part return to the provider (many require it before accepting).
  partReturnRequired Boolean            @default(false)
  // AWAITING → SENT → RECEIVED_BY_PROVIDER (null when not required).
  partReturnStatus  String?
  partSentAt        DateTime?
  partSentReference String?
  partReceivedAt    DateTime?
  // Replacement received / repaired part returned (closes the claim for
  // those remedies).
  replacementSerial String?
  remedyNotes       String?
  // What the CUSTOMER received (separate from what the provider gives
  // us): repaired or replaced at no charge, a goodwill refund, paid, or
  // not covered — recorded whenever it's known.
  customerResolution      CustomerResolution?
  customerResolutionNotes String?
  createdById       String
  reviewRequestedAt DateTime?
  hodApprovedById   String?
  hodApprovedAt     DateTime?
  managerApprovedById String?
  managerApprovedAt DateTime?
  submittedById     String?
  submittedAt       DateTime?
  decidedById       String?
  decidedAt         DateTime?
  settledById       String?
  settledAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt

  warranty         Warranty         @relation(fields: [warrantyId], references: [id])
  provider         WarrantyProvider @relation(fields: [providerId], references: [id])
  customer         Customer         @relation(fields: [customerId], references: [id])
  vehicle          CustomerVehicle? @relation(fields: [vehicleId], references: [id])
  jobCard          JobCard?         @relation(fields: [jobCardId], references: [id])
  vehicleService   VehicleService?  @relation(fields: [vehicleServiceId], references: [id])
  createdBy        User             @relation("WarrantyClaimCreatedBy", fields: [createdById], references: [id])
  hodApprovedBy    User?            @relation("WarrantyClaimHodApprovedBy", fields: [hodApprovedById], references: [id])
  managerApprovedBy User?           @relation("WarrantyClaimManagerApprovedBy", fields: [managerApprovedById], references: [id])
  submittedBy      User?            @relation("WarrantyClaimSubmittedBy", fields: [submittedById], references: [id])
  decidedBy        User?            @relation("WarrantyClaimDecidedBy", fields: [decidedById], references: [id])
  settledBy        User?            @relation("WarrantyClaimSettledBy", fields: [settledById], references: [id])

  @@index([warrantyId])
  @@index([status])
  @@index([jobCardId])
  @@index([vehicleServiceId])
  @@map("warranty_claims")
}

// How a provider makes a failed item right.
enum WarrantyRemedy {
  REIMBURSEMENT
  REPLACEMENT
  REPAIR
}

// Same approval chain as policy deletion: staff request → Warranty HOD →
// Branch Manager. In use → archived; never used → deleted.
model WarrantyProviderDeletionRequest {
  id                 String                 @id @default(cuid())
  // Null once the provider itself has been deleted (name is kept).
  providerId         String?
  reason             String
  status             WarrantyApprovalStatus @default(PENDING_HOD)
  requestedById      String
  requestedAt        DateTime               @default(now())
  hodDecidedById     String?
  hodDecidedAt       DateTime?
  managerDecidedById String?
  managerDecidedAt   DateTime?
  declineReason      String?
  outcome            String?
  providerName       String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @default(now()) @updatedAt

  provider         WarrantyProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  requestedBy      User              @relation("WarrantyProviderDeletionRequestedBy", fields: [requestedById], references: [id])
  hodDecidedBy     User?             @relation("WarrantyProviderDeletionHodDecidedBy", fields: [hodDecidedById], references: [id])
  managerDecidedBy User?             @relation("WarrantyProviderDeletionManagerDecidedBy", fields: [managerDecidedById], references: [id])

  @@index([providerId])
  @@index([status])
  @@map("warranty_provider_deletion_requests")
}

// How long a policy lasts: calendar days, working days (Mon–Fri — e.g.
// workshop goodwill "5 working days after checkout") or months.
enum WarrantyDurationUnit {
  DAYS
  WORKING_DAYS
  MONTHS
}

// What the customer received for a warranty problem.
enum CustomerResolution {
  REPAIRED_NO_CHARGE
  REPLACED_NO_CHARGE
  GOODWILL_REFUND
  CUSTOMER_PAID
  NOT_COVERED
}

// Who pays for a Job Card estimate line.
enum EstimateBillTo {
  CUSTOMER
  WARRANTY
  GOODWILL
  INTERNAL
}

// ─────────────────────────────────────────────────────────────────────────
// SECURITY — the gate. Visitors, Employee Exit Passes and vehicles cleared
// to leave. Every step is audited and every email is logged
// (SecurityEmailLog), so nothing that happened at the gate is ever missing.
// ─────────────────────────────────────────────────────────────────────────

// Security records arrival at the gate (CHECKED_IN = on the premises);
// Reception then receives the visitor and tells the host.
enum VisitStatus {
  EXPECTED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

model Visit {
  id                      String      @id @default(cuid())
  visitNumber             String      @unique
  passNumber              String?     @unique
  branchId                String
  status                  VisitStatus
  // The visitor, or the LEAD of a group (the one whose ID is taken).
  visitorName             String
  // Group visits: how many people in total, and the other people's names
  // (one per person — the lead is visitorName). One pass covers the group.
  partySize               Int         @default(1)
  memberNames             String[]    @default([])
  // Organisation the visitor(s) come from; null = private individual(s).
  company                 String?
  phone                   String?
  idType                  String?
  idNumber                String?
  // How they came: ON_FOOT, CAR, MOTORCYCLE, TRUCK, BUS, OTHER — a plate
  // is required for anything but on foot. vehiclePlate holds every plate
  // (comma-separated) when a group came in more than one vehicle.
  vehicleType             String      @default("ON_FOOT")
  vehiclePlate            String?
  purpose                 String
  hostUserId              String
  expectedAt              DateTime?
  expectedDurationMinutes Int         @default(60)
  isWalkIn                Boolean     @default(false)
  registeredById          String
  receivedAt              DateTime?
  receivedById            String?
  extendedMinutes         Int         @default(0)
  checkedInAt             DateTime?
  checkedInById           String?
  checkedOutAt            DateTime?
  checkedOutById          String?
  overdueNotifiedAt       DateTime?
  notes                   String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @default(now()) @updatedAt

  branch       Branch @relation(fields: [branchId], references: [id])
  host         User   @relation("VisitHost", fields: [hostUserId], references: [id])
  registeredBy User   @relation("VisitRegisteredBy", fields: [registeredById], references: [id])
  checkedInBy  User?  @relation("VisitCheckedInBy", fields: [checkedInById], references: [id])
  checkedOutBy User?  @relation("VisitCheckedOutBy", fields: [checkedOutById], references: [id])
  receivedBy   User?  @relation("VisitReceivedBy", fields: [receivedById], references: [id])

  @@index([branchId, status])
  @@index([hostUserId])
  @@map("visits")
  appointment Appointment?
  // Visitor groups booked on an appointment (one appointment, many groups).
  appointmentId String?
  appointmentGroup Appointment? @relation("AppointmentVisits", fields: [appointmentId], references: [id], onDelete: SetNull)
}

// Employee Exit Pass (the paper form, digital): Department Head authorises,
// the Manager approves, security records Time out / Time in.
enum ExitPassStatus {
  PENDING_HEAD
  PENDING_MANAGER
  APPROVED
  OUT
  RETURNED
  CLOSED
  DECLINED
  CANCELLED
}

model ExitPass {
  id                String         @id @default(cuid())
  passNumber        String         @unique
  branchId          String
  status            ExitPassStatus @default(PENDING_HEAD)
  requestedById     String
  reason            String
  returning         Boolean
  expectedOutAt     DateTime?
  expectedReturnAt  DateTime?
  // How long they plan to be out; the expected return is worked out from
  // the actual time out at the gate.
  expectedDurationMinutes Int?
  headApprovedById  String?
  headApprovedAt    DateTime?
  managerApprovedById String?
  managerApprovedAt   DateTime?
  declinedById      String?
  declinedAt        DateTime?
  declineReason     String?
  cancelReason      String?
  gateOutAt         DateTime?
  gateOutById       String?
  gateInAt          DateTime?
  gateInById        String?
  overdueNotifiedAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt

  branch         Branch @relation(fields: [branchId], references: [id])
  requestedBy    User   @relation("ExitPassRequestedBy", fields: [requestedById], references: [id])
  headApprovedBy User?  @relation("ExitPassHeadApprovedBy", fields: [headApprovedById], references: [id])
  managerApprovedBy User? @relation("ExitPassManagerApprovedBy", fields: [managerApprovedById], references: [id])
  declinedBy     User?  @relation("ExitPassDeclinedBy", fields: [declinedById], references: [id])
  gateOutBy      User?  @relation("ExitPassGateOutBy", fields: [gateOutById], references: [id])
  gateInBy       User?  @relation("ExitPassGateInBy", fields: [gateInById], references: [id])
  people         ExitPassPerson[]

  @@index([branchId, status])
  @@map("exit_passes")
}

// Everyone leaving on one pass — employees (linked) or named non-staff
// (e.g. an intern), with the details the paper form asks for.
model ExitPassPerson {
  id          String  @id @default(cuid())
  exitPassId  String
  userId      String?
  name        String
  employeeId  String?
  designation String?
  department  String?

  exitPass ExitPass @relation(fields: [exitPassId], references: [id], onDelete: Cascade)
  user     User?    @relation("ExitPassPersonUser", fields: [userId], references: [id])

  @@index([exitPassId])
  @@map("exit_pass_people")
}

// A vehicle released by the Workshop (Job Card checked out / Vehicle
// Service collected) confirmed through the gate by security.
model VehicleGateExit {
  id               String   @id @default(cuid())
  exitNumber       String   @unique
  branchId         String
  jobCardId        String?  @unique
  vehicleServiceId String?  @unique
  vehicleId        String
  exitedAt         DateTime @default(now())
  exitedById       String
  driverName       String?
  notes            String?
  createdAt        DateTime @default(now())

  branch         Branch          @relation(fields: [branchId], references: [id])
  jobCard        JobCard?        @relation(fields: [jobCardId], references: [id])
  vehicleService VehicleService? @relation(fields: [vehicleServiceId], references: [id])
  vehicle        CustomerVehicle @relation(fields: [vehicleId], references: [id])
  exitedBy       User            @relation("VehicleGateExitBy", fields: [exitedById], references: [id])

  @@map("vehicle_gate_exits")
}

// Every email the Security module sends — who, what, when, and whether
// it went — so a notice is never "maybe sent".
model SecurityEmailLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  recipient  String
  subject    String
  sent       Boolean
  error      String?
  createdAt  DateTime @default(now())


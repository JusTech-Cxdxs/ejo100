// ─────────────────────────────────────────────────────────────────────────
// SCHEDULING — appointments for officials. Who may keep a calendar is the
// organisation's choice (role "Calendar User"); an official can let aides
// book for them (CalendarDelegate); "Scheduling Admin" manages rooms and
// delegations. Visitors on an appointment become a Security booking.
// ─────────────────────────────────────────────────────────────────────────

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model MeetingRoom {
  id        String   @id @default(cuid())
  branchId  String
  name      String
  location  String?
  capacity  Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  branch       Branch        @relation(fields: [branchId], references: [id])
  appointments Appointment[]

  @@unique([branchId, name])
  @@map("meeting_rooms")
}

model CalendarDelegate {
  id          String   @id @default(cuid())
  ownerId     String
  delegateId  String
  createdById String
  createdAt   DateTime @default(now())

  owner     User @relation("CalendarOwner", fields: [ownerId], references: [id])
  delegate  User @relation("CalendarDelegateUser", fields: [delegateId], references: [id])
  createdBy User @relation("CalendarDelegateCreatedBy", fields: [createdById], references: [id])

  @@unique([ownerId, delegateId])
  @@map("calendar_delegates")
}

model Appointment {
  id                String            @id @default(cuid())
  appointmentNumber String            @unique
  branchId          String
  status            AppointmentStatus @default(SCHEDULED)
  title             String
  agenda            String?
  // Whose calendar it is on (the official) and who booked it (maybe an aide).
  ownerId           String
  createdById       String
  startsAt          DateTime
  endsAt            DateTime
  roomId            String?
  location          String?
  // External visitors are a Security booking (group, organisation, host).
  visitId           String?           @unique
  cancelReason      String?
  completedAt       DateTime?
  cancelledAt       DateTime?
  // When the ~1-hour reminder email went out (sent once; reset on reschedule).
  reminderSentAt    DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  branch       Branch                   @relation(fields: [branchId], references: [id])
  owner        User                     @relation("AppointmentOwner", fields: [ownerId], references: [id])
  createdBy    User                     @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  room         MeetingRoom?             @relation(fields: [roomId], references: [id])
  visit        Visit?                   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  participants AppointmentParticipant[]
  visits       Visit[]                  @relation("AppointmentVisits")

  @@index([ownerId, startsAt])
  @@index([roomId, startsAt])
  @@index([branchId, startsAt])
  @@map("appointments")
}

model AppointmentParticipant {
  id            String @id @default(cuid())
  appointmentId String
  userId        String

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user        User        @relation("AppointmentParticipantUser", fields: [userId], references: [id])

  @@unique([appointmentId, userId])
  @@index([userId])
  @@map("appointment_participants")
}

// ─────────────────────────────────────────────────────────────────────────
// SECURITY INCIDENTS — anything abnormal at the gate or on site, reported by
// Security / Reception, reviewed and closed by the Chief Security Officer.
// ─────────────────────────────────────────────────────────────────────────
enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  UNDER_REVIEW
  CLOSED
}

model SecurityIncident {
  id               String           @id @default(cuid())
  incidentNumber   String           @unique
  branchId         String
  type             String
  severity         IncidentSeverity
  status           IncidentStatus   @default(OPEN)
  occurredAt       DateTime
  location         String
  description      String
  peopleInvolved   String?
  vehiclePlate     String?
  actionTaken      String?
  // Optional link to the record it concerns (Visit / ExitPass /
  // RoadTestPermit / VehicleGateExit) — by type + id + its number.
  relatedType      String?
  relatedId        String?
  relatedNumber    String?
  reportedById     String
  assignedToId     String?
  resolution       String?
  closedAt         DateTime?
  closedById       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt

  branch     Branch @relation(fields: [branchId], references: [id])
  reportedBy User   @relation("IncidentReportedBy", fields: [reportedById], references: [id])
  assignedTo User?  @relation("IncidentAssignedTo", fields: [assignedToId], references: [id])
  closedBy   User?  @relation("IncidentClosedBy", fields: [closedById], references: [id])

  @@index([status, severity])
  @@map("security_incidents")
}

// ─────────────────────────────────────────────────────────────────────────
// DELIVERIES — suppliers arriving at the gate. Security records arrival and

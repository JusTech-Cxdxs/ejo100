// ─────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS & BROADCASTS
// ─────────────────────────────────────────────────────────────────────────
enum BroadcastCategory {
  NEWS
  ANNOUNCEMENT
  IMPORTANT
  URGENT
  SECURITY_ALERT
  MAINTENANCE
  GREETING
}

enum BroadcastAudience {
  ALL
  BRANCH
  DEPARTMENT
  ROLE
  // v28 — messages to customers (portal dashboard + optional email):
  // every active customer of the organisation, or the customers in audienceIds.
  CUSTOMERS_ALL
  CUSTOMERS_SELECTED
}

/// A message to staff — dashboard, marquee, notification centre and
/// (optionally) email — live from startsAt to endsAt, then it switches
/// itself off (an admin can stop, reactivate or delete it).
model Broadcast {
  id              String            @id @default(cuid())
  broadcastNumber String            @unique
  organisationId  String
  category        BroadcastCategory
  title           String
  message         String
  audience        BroadcastAudience @default(ALL)
  // Branch / department ids or role slugs, per the audience.
  audienceIds     String[]          @default([])
  startsAt        DateTime
  // Null = runs until stopped.
  endsAt          DateTime?
  durationLabel   String?
  sendEmail       Boolean           @default(false)
  emailedAt       DateTime?
  isActive        Boolean           @default(true)
  stoppedAt       DateTime?
  stoppedById     String?
  createdById     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("BroadcastCreatedBy", fields: [createdById], references: [id])
  stoppedBy    User?        @relation("BroadcastStoppedBy", fields: [stoppedById], references: [id])

  @@index([isActive, startsAt])
  @@index([organisationId, updatedAt])
  @@map("broadcasts")
}

/// What a person has read in their notification centre: "audit:<id>"
/// for activity, "bc:<id>" for broadcasts.
model NotificationRead {
  id     String   @id @default(cuid())
  userId String
  key    String
  readAt DateTime @default(now())

  user User @relation("NotificationReads", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("notification_reads")
}

model NotificationPreference {
  userId    String   @id
  muted     Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation("NotificationPreference", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// Everyone going out on a road test besides the driver — staff (linked to
/// their user) or other people by name, like the exit pass.
model RoadTestPerson {
  id          String  @id @default(cuid())
  roadTestId  String
  userId      String?
  name        String
  employeeId  String?

  roadTest RoadTestPermit @relation(fields: [roadTestId], references: [id], onDelete: Cascade)
  user     User?          @relation("RoadTestPersonUser", fields: [userId], references: [id])

  @@index([roadTestId])
  @@map("road_test_people")
}

/// v29: Assisted sessions. A Branch Assistant helps a colleague who is not
/// comfortable with computers: the colleague confirms with their own password,
/// and for a limited time the assistant works on the colleague's tasks. Every
/// action is recorded as done by the assistant for the colleague. Only roles
/// without approval, money or administration rights can be assisted.
model AssistSession {
  id             String    @id @default(cuid())
  organisationId String
  assistantId    String
  subjectId      String
  branchId       String?
  reason         String?
  consentMethod  String    @default("password")
  startedAt      DateTime  @default(now())
  expiresAt      DateTime
  endedAt        DateTime?
  endedReason    String?
  ipAddress      String?
  userAgent      String?

  assistant User @relation("AssistSessionAssistant", fields: [assistantId], references: [id])
  subject   User @relation("AssistSessionSubject", fields: [subjectId], references: [id])

  @@index([assistantId, endedAt])
  @@index([subjectId, startedAt])
  @@index([organisationId, startedAt])
  @@map("assist_sessions")
}

/// v29 — Every unexpected error a person sees carries a short reference
/// ("quote reference 3553129217"). The reference, where it happened and a
/// secret-free summary are kept here so IT can look it up on the Error log
/// page instead of searching server logs.
model ErrorEvent {
  id             String   @id @default(cuid())
  ref            String
  app            String
  organisationId String?
  userId         String?
  customerId     String?
  method         String?
  path           String?
  route          String?
  kind           String?
  name           String?
  message        String
  stack          String?
  createdAt      DateTime @default(now())

  @@index([ref])
  @@index([organisationId, createdAt])
  @@index([createdAt])
  @@map("error_events")
}


/// v30 — Recycle bin. A record created by mistake (a Job Card opened on the
/// wrong vehicle, a duplicate customer) is moved here while nothing of
/// consequence has happened to it: no payment, no approved estimate, no parts,
/// no warranty, no gate exit. The live rows are deleted in the same
/// transaction, and `snapshot` keeps every deleted row (parent first) so the
/// organisation's administrators can restore it exactly within the retention
/// period. After `purgeAfter` the platform's clean-up removes the snapshot;
/// this row stays as a short tombstone (reference, who, when, why).
/// Records with business consequences are never deleted: they are cancelled
/// or closed through their own workflow.
model RecycleBinItem {
  id                String    @id @default(cuid())
  organisationId    String
  // The branch of a branch-owned record (Job Card, Vehicle Service, part);
  // null for customers and vehicles, which belong to the organisation.
  branchId          String?
  // JobCard | VehicleService | Customer | CustomerVehicle | Part
  entityType        String
  entityId          String
  // The human reference without personal details ("JC-2026-000123").
  reference         String
  // What people see in the bin ("JC-2026-000123 · Toyota Hilux KJA-219-XY · Ada Okafor").
  label             String
  reason            String
  // { v: 1, rows: [{ model, data }] } in insert order. Null once purged or restored.
  snapshot          Json?
  deletedById       String
  deletedAt         DateTime  @default(now())
  purgeAfter        DateTime
  restoredAt        DateTime?
  restoredById      String?
  // The reference it came back under, when the old one had been reused.
  restoredReference String?
  purgedAt          DateTime?
  purgedById        String?

  @@index([organisationId, deletedAt])
  @@index([entityType, entityId])
  @@index([purgeAfter])
  @@map("recycle_bin_items")
}

// ═══════════════════════════════════════════════════════════════════════
// v31 — Enyo 1.0 (AI), support tickets, reminders, mailbox. Additive only.
// Ids of people and records are plain strings (no foreign keys to existing
// tables), like ErrorEvent and RecycleBinItem, so nothing existing changes.
// ═══════════════════════════════════════════════════════════════════════

/// Per-organisation switches for Enyo. No row = defaults (everything on, predictions in shadow).
model EnyoSetting {
  organisationId    String   @id
  // Master switch: off = every Enyo feature hidden; the ERP works as before.
  enabled           Boolean  @default(true)
  staffAssistant    Boolean  @default(true)
  customerAssistant Boolean  @default(true)
  publicAssistant   Boolean  @default(true)
  mailAi            Boolean  @default(true)
  // SHADOW (measured, never shown) | SUGGEST (shown as suggestions) | OFF
  predictionsMode   String   @default("SHADOW")
  // Display name and greeting shown to staff and customers (branding).
  displayName       String   @default("Enyo")
  // v32: the automation level of each learning capability, e.g.
  // {"JOB_DURATION":"SHADOW","PRICE_ANOMALY":"ASSIST"}. Missing = the
  // capability's default (OFF or SHADOW); see lib/enyo/ml/capabilities.ts.
  capabilityLevels  Json?
  // v33: learn only from records opened on or after this day (Lagos). Set it
  // to the go-live date so test data typed while trying the system out is
  // never learned from. Null = all history (up to three years).
  learnFrom         DateTime? @db.Date
  updatedById       String?
  updatedAt         DateTime @updatedAt

  @@map("enyo_settings")
}

enum EnyoChannel {
  STAFF
  CUSTOMER
  PUBLIC
}

enum EnyoMessageRole {
  USER
  ASSISTANT
  TOOL
}

/// One chat thread. Staff: userId. Customer portal: customerId. Public website: visitorKey (random, no personal data).
model EnyoConversation {
  id             String            @id @default(cuid())
  organisationId String
  channel        EnyoChannel
  userId         String?
  customerId     String?
  visitorKey     String?
  title          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  archivedAt     DateTime?
  messages       EnyoMessage[]

  @@index([userId, updatedAt])
  @@index([customerId, updatedAt])
  @@index([visitorKey, updatedAt])
  @@index([organisationId, createdAt])
  // Daily clean-up by channel and age.
  @@index([channel, updatedAt])
  @@index([archivedAt])
  @@map("enyo_conversations")
}

model EnyoMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   EnyoConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           EnyoMessageRole
  content        String
  // ASSISTANT: the tool calls it asked for. TOOL: the tool's name (result kept short, redacted).
  toolName       String?
  toolCalls      Json?
  // { sources: [{ label, href }] } shown under an answer.
  citations      Json?
  model          String?
  tokensIn       Int?
  tokensOut      Int?
  latencyMs      Int?
  // 1 = helpful, -1 = not helpful, from the person who asked.
  rating         Int?
  ratingNote     String?
  // Public website only: a salted hash of the visitor's address, for rate limits. Never the address itself.
  ipHash         String?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@index([ipHash, createdAt])
  @@map("enyo_messages")
}

/// Facts a staff member asked Enyo to remember ("call me Ada"). Theirs only; visible and deletable by them.
model EnyoMemory {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  fact           String
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@map("enyo_memories")
}

enum EnyoPredictionStatus {
  SHADOW
  SHOWN
  RESOLVED
  DISMISSED
}

/// What Enyo predicted for a record (e.g. likely estimate lines for a Job Card), and how it compared with what people actually did.
model EnyoPrediction {
  id             String               @id @default(cuid())
  organisationId String
  branchId       String?
  // JOB_CARD_LINES | SERVICE_LINES
  kind           String
  subjectType    String
  subjectId      String
  modelVersion   String
  input          Json
  output         Json
  status         EnyoPredictionStatus @default(SHADOW)
  // What was finally approved, and the comparison.
  outcome        Json?
  precision      Float?
  recall         Float?
  createdAt      DateTime             @default(now())
  resolvedAt     DateTime?

  @@unique([kind, subjectType, subjectId])
  @@index([organisationId, kind, createdAt])
  @@map("enyo_predictions")
}

enum SupportTicketStatus {
  OPEN
  WAITING_ON_CUSTOMER
  // v36: waiting on someone else (manufacturer, supplier, insurer); the customer sees "With our team".
  ON_HOLD
  RESOLVED
  CLOSED
}

enum SupportChannel {
  CUSTOMER_PORTAL
  WEBSITE
  // v36: an email to a support address (support@, warranty@, technical@ …).
  EMAIL
  // v36: opened by a colleague (a phone call, a walk-in).
  STAFF
}

/// A customer or website visitor handed over from Enyo to the company's people.
model SupportTicket {
  id              String              @id @default(cuid())
  organisationId  String
  branchId        String?
  // SUP-2026-000001
  number          String              @unique
  channel         SupportChannel
  customerId      String?
  contactName     String
  contactPhone    String?
  contactEmail    String?
  subject         String
  // Enyo's hand-over summary for the person picking it up.
  summary         String
  // The Enyo conversation holding the transcript.
  conversationId  String?
  status          SupportTicketStatus @default(OPEN)
  assignedToId    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  replies         SupportReply[]

  // ── v36: the Support centre ─────────────────────────────────────────
  // Which team (queue) owns it, and the address it came in to / goes out from.
  queueId          String?
  mailboxId        String?
  // URGENT | HIGH | NORMAL | LOW
  priority         String    @default("NORMAL")
  // What it is about (Enyo's triage or a colleague's choice) and how it reads.
  topic            String?
  sentiment        String?
  language         String?
  tags             String[]  @default([])
  // Plates, VINs and record numbers found in the messages (linked on the ticket page).
  entities         Json?
  // The sender proved to be the customer (signed in, or the email passed DMARC
  // and matches the customer's address). Only then may records be discussed.
  verified         Boolean   @default(false)
  // The email's sender domain proved the address (DMARC, or SPF and DKIM).
  // Enyo answers an email by itself only then (a forged sender never gets an AI reply).
  authenticatedSender Boolean @default(false)
  // Unguessable; the customer's "solved / talk to a person / rate us" page.
  token            String?   @unique
  // Service targets, worked out in business hours when the ticket opens.
  dueFirstResponseAt DateTime?
  dueResolutionAt  DateTime?
  slaWarnedAt      DateTime?
  slaBreachedAt    DateTime?
  lastCustomerAt   DateTime?
  lastAgentAt      DateTime?
  pendingSince     DateTime?
  nudgeCount       Int       @default(0)
  reopenCount      Int       @default(0)
  closedAt         DateTime?
  // Why a person was needed (customer_asked, low_confidence, sensitive, …).
  handoverReason   String?
  // ANSWERED (Enyo replied) → CONFIRMED (customer said solved) | ASSUMED (no
  // further question) | ESCALATED (asked for a person) — the AI resolution measures.
  aiOutcome        String?
  aiAnsweredAt     DateTime?
  // Waiting for Enyo to read it (triage, then an answer or a draft) — done
  // by the scheduled run, so taking in mail stays fast.
  aiPendingAt      DateTime?
  csatScore        Int?
  csatComment      String?
  csatAt           DateTime?
  csatRequestedAt  DateTime?
  // The email that opened it (Message-ID), for threading replies.
  sourceMessageId  String?
  // v37 — who is writing, as the Support centre recognised them from their
  // address or session: customer | staff | both (a colleague who is also a
  // customer) | unknown. And the colleague, when it is one.
  senderKind       String?
  senderUserId     String?
  // v37 — a colleague's own request for help (Get help in the portal): only
  // that colleague, the help queue's members and support managers see it.
  requesterUserId  String?

  @@index([requesterUserId, createdAt])
  @@index([organisationId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([organisationId, queueId, status])
  @@index([status, dueFirstResponseAt])
  @@index([sourceMessageId])
  @@index([aiPendingAt])
  @@map("support_tickets")
}

/// v36 — a support team and its address(es): General, Warranty, Technical,
/// Customer care, Parts, Sales … Each has its own targets and AI reply mode.
model SupportQueue {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  // general | warranty | technical | customer_care | parts | sales | other
  kind           String   @default("general")
  description    String?
  // A branch's own queue (null: the whole organisation).
  branchId       String?
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  // OFF: people only · SUGGEST: Enyo drafts, people send · AUTO: Enyo answers
  // general questions itself when it is confident; everything else goes to people.
  aiMode         String   @default("SUGGEST")
  autoAcknowledge Boolean @default(true)
  // v38 — the team's own words in its automatic reply (opening times, what
  // to include, an emergency number), shown above the reference and target.
  ackMessage     String?
  // Minutes per priority: { URGENT: { first, resolve }, … } (defaults when null).
  targets        Json?
  signature      String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  members        SupportQueueMember[]
  mailboxes      SupportMailbox[]

  @@unique([organisationId, name])
  @@index([organisationId, active])
  @@map("support_queues")
}

/// v36 — who works a queue, how many open tickets they take, and whether they are away.
model SupportQueueMember {
  queueId        String
  queue          SupportQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  userId         String
  organisationId String
  capacity       Int      @default(15)
  away           Boolean  @default(false)
  // v38 — a team lead is emailed when nobody on the team can take a new
  // request (all away or full) and when a request misses its target.
  isLead         Boolean  @default(false)
  lastAssignedAt DateTime?
  createdAt      DateTime @default(now())

  @@id([queueId, userId])
  @@index([organisationId, userId])
  @@map("support_queue_members")
}

/// v36 — a shared support mailbox (support@, warranty@ …): read for new
/// mail on a schedule, replies sent from it. The password is encrypted
/// (AES-256-GCM, MAILBOX_ENCRYPTION_KEY) and never shown or logged.
model SupportMailbox {
  id             String   @id @default(cuid())
  organisationId String
  queueId        String
  queue          SupportQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  address        String
  displayName    String?
  imapHost       String
  imapPort       Int
  imapSecure     Boolean  @default(true)
  smtpHost       String
  smtpPort       Int
  smtpSecure     Boolean  @default(true)
  username       String
  secret         String
  // ACTIVE | ERROR | PAUSED
  status         String   @default("ACTIVE")
  lastSyncAt     DateTime?
  lastError      String?
  // Where reading continues from (IMAP UID and its validity).
  lastUid        Int      @default(0)
  uidValidity    String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organisationId, address])
  @@index([status, lastSyncAt])
  @@map("support_mailboxes")
}

/// v36 — the organisation's support settings: opening hours, holidays and the AI threshold.
model SupportSetting {
  organisationId String   @id
  // { "1": ["08:00","17:00"], …, "6": ["09:00","13:00"] } (1 = Monday; missing = closed)
  hours          Json?
  // ["2026-10-01", …]
  holidays       String[] @default([])
  // How sure Enyo must be (0–1) before it answers by itself in AUTO queues.
  aiThreshold    Float    @default(0.75)
  nudgeAfterHours Int     @default(48)
  autoResolveDays Int     @default(7)
  closeAfterDays Int      @default(4)
  csatEnabled    Boolean  @default(true)
  // v38 — public holidays come from a calendar worked out each year
  // ("NG": Nigeria's fixed dates, Easter dates and the Islamic holidays),
  // plus the extra days in `holidays`, minus any calendar days listed in
  // `holidaysOff` (e.g. the branch opens on Boxing Day). Null = no calendar.
  holidayCalendar String?  @default("NG")
  holidaysOff    String[] @default([])
  updatedById    String?
  updatedAt      DateTime @updatedAt

  @@map("support_settings")
}

model SupportReply {
  id           String        @id @default(cuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Staff author; null when the customer wrote it.
  authorUserId String?
  fromCustomer Boolean       @default(false)
  body         String
  createdAt    DateTime      @default(now())
  // v36 — PUBLIC (the customer sees it) or INTERNAL (a colleague's note, never shown to the customer).
  visibility   String        @default("PUBLIC")
  // CUSTOMER | AGENT | AI | SYSTEM (acknowledgement, nudge) | NOTE
  kind         String        @default("AGENT")
  // Written with Enyo's help (a draft the colleague sent).
  aiDrafted    Boolean       @default(false)
  // Email threading: this message's Message-ID, and where it came from.
  emailMessageId String?
  fromAddress  String?
  // Attachment names and sizes (the files stay in the mailbox).
  attachments  Json?
  // Exactly-once intake of an email (mailbox + Message-ID hash).
  intakeKey    String?       @unique
  // v37 — Enyo's own replies and drafts: how sure it was, the model, the
  // approved answers it used, and what it knew about the sender (kind,
  // proven, the records and links it was given — never message text).
  aiConfidence Float?
  aiModel      String?
  aiSources    String[]      @default([])
  aiContext    Json?
  // v37 — a person's check of Enyo's reply (the Support centre's "Enyo's
  // replies" page): GOOD | FIXED (a corrected answer was written) | WRONG,
  // and for drafts automatically USED (sent nearly as written) | EDITED |
  // IGNORED. The reason is a fixed code (knowledge_gap, wrong_facts …).
  reviewStatus String?
  reviewReason String?
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?

  @@index([kind, reviewStatus, createdAt])
  @@index([ticketId, createdAt])
  @@index([emailMessageId])
  @@map("support_replies")
}

enum ReminderStatus {
  PENDING
  SENT
  DONE
  CANCELLED
}

/// A reminder for one person, set by them, by someone they allowed, or by Enyo at their request.
model Reminder {
  id             String         @id @default(cuid())
  organisationId String
  // Who is reminded.
  ownerId        String
  // Who set it (the owner, a delegate, or the owner through Enyo).
  createdById    String
  // form | enyo
  source         String         @default("form")
  title          String
  notes          String?
  dueAt          DateTime
  // Optional link to a record: JobCard, VehicleService, Customer, …
  recordType     String?
  recordId       String?
  recordRef      String?
  viaEmail       Boolean        @default(true)
  status         ReminderStatus @default(PENDING)
  sentAt         DateTime?
  doneAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, dueAt])
  @@index([ownerId, status, dueAt])
  @@map("reminders")
}

/// "This person may set reminders for me."
model ReminderDelegate {
  id             String   @id @default(cuid())
  organisationId String
  ownerId        String
  delegateId     String
  createdAt      DateTime @default(now())

  @@unique([ownerId, delegateId])
  @@index([delegateId])
  @@map("reminder_delegates")
}

enum MailAccountStatus {
  ACTIVE
  ERROR
  DISCONNECTED
}

/// A staff member's own work mailbox, connected by IMAP/SMTP. The password is encrypted (AES-256-GCM) and never returned.
model MailAccount {
  id             String            @id @default(cuid())
  organisationId String
  userId         String
  address        String
  displayName    String?
  imapHost       String
  imapPort       Int
  imapSecure     Boolean           @default(true)
  smtpHost       String
  smtpPort       Int
  smtpSecure     Boolean           @default(true)
  username       String
  secret         String
  // Set when the person allows Enyo to read, sort and summarise this mailbox.
  aiConsentAt    DateTime?
  status         MailAccountStatus @default(ACTIVE)
  lastSyncAt     DateTime?
  lastError      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  messages       MailMessage[]

  @@unique([userId, address])
  @@map("mail_accounts")
}

model MailMessage {
  id             String      @id @default(cuid())
  accountId      String
  account        MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  folder         String
  uid            Int
  messageId      String?
  inReplyTo      String?
  threadKey      String?
  fromAddress    String
  fromName       String?
  toList         Json
  ccList         Json?
  subject        String
  snippet        String
  bodyText       String?
  // v34: the email's own layout, cleaned (lib/mail/html.ts): no scripts, no
  // forms, no tracking; remote images held back until the owner asks.
  bodyHtml       String?
  receivedAt     DateTime
  seen           Boolean     @default(false)
  flagged        Boolean     @default(false)
  hasAttachments Boolean     @default(false)
  // Enyo's brief (only with consent).
  aiSummary      String?
  aiCategory     String?
  aiPriority     Int?
  aiActions      Json?
  linkedRefs     Json?
  aiAt           DateTime?
  // v34: briefs that came back empty; after two, Enyo stops trying on its own.
  aiTries        Int         @default(0)
  createdAt      DateTime    @default(now())

  @@unique([accountId, folder, uid])
  @@index([accountId, folder, receivedAt])
  // Daily 90-day clean-up.
  @@index([receivedAt])
  @@map("mail_messages")
}

// v32 — Enyo machine learning: each organisation's own trained models. Additive only.

enum EnyoModelStatus {
  // Trained and passed its checks; not used until someone chooses it.
  CANDIDATE
  // The model in use for its task (one per organisation and task).
  ACTIVE
  // Replaced or switched off; kept for the record.
  RETIRED
  // Failed its acceptance checks (kept so people can see why).
  REJECTED
}

/// A model trained for one organisation (by the Python trainer, ml/), with its
/// evaluation and the portable artifact the portal runs. Only one ACTIVE model
/// per organisation and task; promotion is a person's decision (enyo.manage).
model EnyoModel {
  id             String          @id @default(cuid())
  organisationId String
  // JOB_DURATION | ESTIMATE_LINES | PARTS_DEMAND | PRICE_ANOMALY | COMPLAINT_THEMES
  task           String
  // e.g. "job-duration-gbm-20261015-a1b2"
  version        String
  // e.g. "lightgbm-quantile", "tfidf-logreg-ovr", "croston-sba", "isolation-forest", "tfidf-kmeans"
  algorithm      String
  status         EnyoModelStatus @default(CANDIDATE)
  // Held-out evaluation, the baseline it was compared with, and the gate result.
  metrics        Json
  baseline       Json?
  gate           Json
  // The portable model (coefficients, trees, tables) the portal evaluates.
  artifact       Json
  artifactBytes  Int
  rows           Int
  dataFrom       DateTime?
  dataTo         DateTime?
  // Trainer name and versions (python, scikit-learn, lightgbm).
  trainer        String
  trainedAt      DateTime
  createdAt      DateTime        @default(now())
  promotedAt     DateTime?
  promotedById   String?
  retiredAt      DateTime?

  @@unique([organisationId, version])
  @@index([organisationId, task, status])
  @@map("enyo_models")
}

// v35 — what Enyo has learned: answers people marked helpful (first question of
// a chat, no records read), and replies colleagues wrote when Enyo handed a
// question over. Personal details removed. An administrator approves each one
// before Enyo uses it as an example or reuses it for the same question.
// Additive only.
model EnyoLearnedAnswer {
  id              String   @id @default(cuid())
  organisationId  String
  // STAFF | CUSTOMER | PUBLIC | SUPPORT
  channel         String
  question        String
  answer          String
  // The question's words as Enyo compares them (lib/enyo/predict/text.ts tokenise).
  tokens          Json
  // Where it came from: the rated answer, or the support reply.
  source          String
  sourceId        String   @unique
  // PENDING until an administrator approves it on the Enyo learning page;
  // only APPROVED answers are ever shown to the model or reused.
  status          String   @default("PENDING")
  approvedById    String?
  approvedAt      DateTime?
  uses            Int      @default(0)
  lastUsedAt      DateTime?
  createdById     String?
  createdAt       DateTime @default(now())

  @@index([organisationId, channel, status, createdAt])
  @@map("enyo_learned_answers")
}

// v37 — the integrity watch: unusual or risky activity found by the checks in
// apps/portal/lib/integrity (money, parts and procurement, warranty, gate,
// access, sign-ins) or raised by a colleague (Speak up). An administrator
// reviews each one; nobody reviews an alert about themselves. A flag is a
// reason to look, never proof: nothing is decided automatically.
// Additive only.
model IntegrityAlert {
  id             String    @id @default(cuid())
  organisationId String
  // The check that raised it (refund_exceeds_paid, same_person_approval …, speak_up).
  rule           String
  // LOW | MEDIUM | HIGH
  severity       String
  // NEW | REVIEWING | CONFIRMED | DISMISSED
  status         String    @default("NEW")
  title          String
  // Plain facts for the reviewer (amounts, dates, numbers — no message text).
  evidence       Json?
  // The record it is about, and the colleague whose activity it is about.
  entityType     String?
  entityId       String?
  subjectUserId  String?
  branchId       String?
  // One alert per rule and record: the checks run again and only update it.
  fingerprint    String
  score          Float?
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  seenCount      Int       @default(1)
  // A Speak up report: who raised it (null when they chose to stay anonymous).
  reportedById   String?
  assignedToId   String?
  reviewedById   String?
  reviewedAt     DateTime?
  resolution     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@unique([organisationId, fingerprint])
  @@index([organisationId, status, severity, lastSeenAt])
  @@index([organisationId, rule, createdAt])
  @@index([subjectUserId])
  @@map("integrity_alerts")
}

// v37 — how a person writes: their own emails sent from the portal (only when
// they allowed Enyo to read their mail), so Enyo drafts in their voice and
// layout. Used only for that person's own drafts; never shared, never used
// for training; 90 days, at most 200 per person. Additive only.
model MailStyleSample {
  id             String   @id @default(cuid())
  userId         String
  organisationId String?
  subject        String
  body           String
  // The words as Enyo compares them (lib/enyo/predict/text.ts tokenise).
  tokens         Json
  isReply        Boolean  @default(false)
  sentAt         DateTime @default(now())

  @@index([userId, sentAt])
  @@map("mail_style_samples")
}

// v38 — the organisation's leadership and other people it publishes (name,
// title, the part of the business they lead, a short public biography and a
// public profile link). Managed by administrators on Organisation → People we
// publish. Enyo (website, customer portal and staff portal) answers "who is …"
// questions from this list; only rows marked public reach the website and
// customer portal. No contact details are kept here. Additive only.
model PublicProfile {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  title          String
  // The part of the business they lead or work in ("Automobile Division", "Group IT").
  area           String?
  bio            String?
  // A public professional page (LinkedIn or the organisation's website), https only.
  profileUrl     String?
  // Shown on the website and the customer portal (staff always see them).
  isPublic       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdById    String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([organisationId, sortOrder])
  @@map("public_profiles")
}

/// One page view on the public website (v40): anonymous and cookie-less — the
/// visitor is a daily keyed hash of address + browser (never stored, cannot be
/// reversed; no name), the page path without its
/// query, the referring site's host, the kind of device and the seconds spent.
/// Feeds IT's website report (visitors per day, top pages, time on page, how
/// many also chatted with Enyo). Page paths keep no tokens: long ids are
/// replaced with ":id".
model SiteVisit {
  id             String   @id @default(cuid())
  organisationId String
  day            DateTime @db.Date
  visitorHash    String
  sessionId      String
  path           String
  referrerHost   String?
  device         String
  startedAt      DateTime @default(now())
  durationSec    Int      @default(0)
  /// The same visitor talked to Enyo that day (set when the page is left).
  chatted        Boolean  @default(false)

  @@index([organisationId, day])
  @@index([organisationId, startedAt])
  @@index([visitorHash, day])
  @@map("site_visits")
}

enum NewsCategory {
  NEWS
  MILESTONE
  PRESS_RELEASE
  EVENT
  COMMUNITY
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// News & media (v41): what the communications team publishes on the public
/// website — a story, a milestone (a new assembly line), a press release, an
/// event or a community programme. Written and published in the staff portal
/// (News & media); the website shows published posts of its organisation.
/// The body is Markdown (headings, lists, links; no raw HTML is ever rendered).
model NewsPost {
  id             String       @id @default(cuid())
  organisationId String
  slug           String
  title          String
  summary        String
  body           String
  category       NewsCategory @default(NEWS)
  status         NewsStatus   @default(DRAFT)
  /// An https address of the cover picture (the organisation's own hosting); none → a themed cover.
  coverImageUrl  String?
  coverAlt       String?
  /// Shown first on the website's home page and at the top of News.
  isFeatured     Boolean      @default(false)
  /// The business the story is about ("Automotive", "Agriculture"); free text, used for filtering.
  businessArea   String?
  publishedAt    DateTime?
  authorName     String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@unique([organisationId, slug])
  @@index([organisationId, status, publishedAt])
  @@map("news_posts")
}

// ─── Data Exchange (v-A1): bringing existing data in from SAP and spreadsheets ───
//
// One import = one file for one kind of record (customers, vehicles, …).
// The browser reads the file and sends its rows in blocks into ImportRow (a
// staging table), so a file of any size never travels in one request and an
// interrupted upload carries on. Nothing touches the live records until a
// second person approves; the load then runs in batches, can be paused, and
// is idempotent. Statuses are text (checked in code) so new steps never need
// a database type change.
model ImportJob {
  id             String   @id @default(cuid())
  // IMP-2026-000001
  number         String   @unique
  organisationId String
  // Branch-owned records (parts, stock) load into this branch; customers and vehicles do not need one.
  branchId       String?
  // customers | vehicles (later: parts, stock, suppliers, …)
  entity         String
  fileName       String
  // SHA-256 of the file as read in the browser: the same file twice is recognised.
  fileSha256     String
  fileRows       Int      @default(0)
  // The file's column headers, in order.
  headers        Json
  // { fieldKey: headerIndex } — which column feeds which field.
  mapping        Json?
  // ADD_ONLY: matches are skipped. FILL_BLANKS: matches get only their empty fields filled. Nothing is ever overwritten.
  matchMode      String   @default("ADD_ONLY")
  // Where the file came from: SAP | LEGACY (an old system or spreadsheet). Stamped on every record as externalSource.
  sourceSystem   String   @default("SAP")
  // Rows that only MIGHT be an existing record (same phone, different name and number): SKIP them (listed for
  // follow-up) or ADD them as new. Never merged silently.
  possibleDuplicates String @default("SKIP")
  // UPLOADING → UPLOADED → VALIDATING → VALIDATED → AWAITING_APPROVAL → APPROVED → LOADING ⇄ PAUSED → COMPLETED;
  // also CANCELLED, FAILED, UNDONE.
  status         String   @default("UPLOADING")
  goodRows       Int      @default(0)
  warningRows    Int      @default(0)
  rejectedRows   Int      @default(0)
  duplicateRows  Int      @default(0)
  matchedRows    Int      @default(0)
  createdRows    Int      @default(0)
  updatedRows    Int      @default(0)
  skippedRows    Int      @default(0)
  // Totals shown in the reconciliation report (e.g. stock quantity and value).
  totals         Json?
  // Opening stock (v-A2): the cut-over date the stock was counted at — the date of its opening-balance receipts.
  asOf           DateTime?
  // Opening stock (v-A2): Finance confirms the loaded quantity and value (a second sign-off after the Store's approval).
  signedOffById  String?
  signedOffAt    DateTime?
  // v-A3 registers: the register the whole file is (PRODUCTION | QC | PDI) when it has no column for it.
  defaultKind    String?
  // The staged copy of the file: bytes it takes (measured), and when it was
  // released (the summary, the report's outcomes, rejected rows and what undo
  // needs are kept; the rest of the file's cells are cleared).
  stagedBytes     Int?
  rowsReleasedAt  DateTime?
  rowsReleasedById String?
  error          String?
  createdById    String
  submittedAt    DateTime?
  approvedById   String?
  approvedAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  undoneById     String?
  undoneAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ImportJobCreatedBy", fields: [createdById], references: [id])
  approvedBy   User?        @relation("ImportJobApprovedBy", fields: [approvedById], references: [id])
  rows         ImportRow[]

  @@index([organisationId, createdAt])
  @@index([organisationId, entity, fileSha256])
  @@map("import_jobs")
}

/// One row of an imported file, as it was in the file, with what checking and loading made of it.
model ImportRow {
  id        String   @id @default(cuid())
  jobId     String
  // The row's line in the file (the header is line 1), as people see it in Excel.
  rowNumber Int
  // The cell values, in header order.
  cells     Json
  // PENDING → GOOD | WARNING | REJECTED | DUPLICATE; when loaded: CREATED | UPDATED | SKIPPED; UNDONE after an undo.
  status    String   @default("PENDING")
  // [{ field, message, level: "error" | "warning" }]
  issues    Json?
  // The keys the row is recognised by ("ext:1000123", "email:…", "vin:…"): finds duplicates across the whole file.
  keys      String[] @default([])
  // An existing record this row matched (by SAP number, email, phone, VIN, plate…).
  matchedId String?
  matchedBy String?
  // The record created or updated from this row, and (FILL_BLANKS) which fields were filled — what an undo reverses.
  resultId  String?
  filled    String[] @default([])

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, rowNumber])
  @@index([jobId, status])
  @@map("import_rows")
}

/// A saved column matching ("SAP customer master", "Workshop Excel 2024"), offered for the next file of the same kind.
model ImportMappingProfile {
  id             String   @id @default(cuid())
  organisationId String
  entity         String
  name           String
  // { fieldKey: headerName } — by header name, so it fits a file whose columns are in another order.
  mapping        Json
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ImportMappingProfileCreatedBy", fields: [createdById], references: [id])

  @@unique([organisationId, entity, name])
  @@map("import_mapping_profiles")
}

/// v-A2: the organisation's suppliers (SAP vendors), shared by every branch. Goods receipts keep the supplier's
/// name as typed and link here when it matches; brought in from SAP (LIFNR) or typed in.
model Supplier {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  taxId          String?
  isActive       Boolean  @default(true)
  // The supplier's number in another system: externalSource SAP and externalId the vendor number (LIFNR).
  externalSource String?
  externalId     String?
  importJobId    String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User           @relation("SupplierCreatedBy", fields: [createdById], references: [id])
  receipts     GoodsReceipt[]

  @@unique([organisationId, externalSource, externalId])
  @@index([organisationId, name])
  @@index([importJobId])
  @@index([organisationId, externalId])
  @@map("suppliers")
}

// v-A3 Data Exchange: invoices from SAP (billing documents or customer line
// items) from before EJO 100. Read-only history: never edited, never paid or
// refunded here, never shown to the customer. Counted in the customer's total
// spend and last visit and in the CRM and Headquarters analytics, always
// labelled "from SAP, before EJO". The customer (and the vehicle, matched by
// its VIN) are linked by id without a foreign key, so the history survives a
// customer moving through the Recycle bin. "Undo" voids rows (voidedAt) and
// a reload un-voids them: nothing is ever deleted.
model HistoricalInvoice {
  id             String    @id @default(cuid())
  organisationId String
  // The branch whose sales it was (chosen when the import starts).
  branchId       String?
  customerId     String
  vehicleId      String?
  // The chassis number as written on the invoice, and in capitals without spaces (to find the vehicle).
  vin            String?
  vinKey         String?
  // SAP billing document (VBELN) or accounting document (BELNR) number.
  invoiceNumber  String
  invoiceDate    DateTime  @db.Date
  // Gross amount in naira (net + tax when both are given); negative for a credit note.
  amount         Decimal   @db.Decimal(14, 2)
  // SAP billing type (FKART) or document type (BLART), e.g. F2, G2, DR.
  documentType   String?
  // SAP numbers documents per company code and fiscal year: the same number can
  // come back in another year. Fiscal year (GJAHR) from the file, else the
  // invoice date's year; company code (BUKRS) when given. When either is given
  // in the file, externalSource is "SAP/<company code>/<year>" — the numbering
  // range — so the unique key below keeps such invoices apart.
  companyCode    String?
  fiscalYear     Int?
  description    String?
  externalSource String    @default("SAP")
  importJobId    String?
  voidedAt       DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, externalSource, invoiceNumber], map: "historical_invoices_org_source_number_key")
  @@index([customerId, invoiceDate])
  @@index([organisationId, invoiceDate])
  // Search by the number alone (any company code and year).
  @@index([organisationId, invoiceNumber])
  @@index([vehicleId])
  @@index([vinKey])
  @@index([importJobId])
  @@map("historical_invoices")
}

// v-A3 Data Exchange: the plant's existing production, QC and PDI registers
// (Excel), one row per vehicle per check. Read-only history shown on the
// vehicle by its VIN (the vehicle may be a customer's or still in stock).
// Staff only: inspectors' names are never shown to customers. Undo voids.
model VehicleHistoryRecord {
  id             String    @id @default(cuid())
  organisationId String
  vin            String
  vinKey         String
  model          String?
  // PRODUCTION | QC | PDI
  kind           String
  eventDate      DateTime  @db.Date
  // Line station, QC gate or PDI step, as the register names it.
  stage          String?
  // PASS | FAIL | REWORK | OPEN, or the register's own word.
  result         String?
  inspector      String?
  reference      String?
  notes          String?
  // The same check is never loaded twice: kind + VIN + date + stage, as one key.
  dedupeKey      String
  externalSource String    @default("REGISTER")
  importJobId    String?
  voidedAt       DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, dedupeKey])
  @@index([organisationId, vinKey])
  @@index([importJobId])
  @@map("vehicle_history_records")
}


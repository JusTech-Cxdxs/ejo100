// ============================================================================
// EJO 100 ENTERPRISE PLATFORM — CORE DATABASE SCHEMA
// Phase 1: organization hierarchy, module registry, branding config.
// Phase 2 (added below, Phase 1 models untouched): Better Auth tables,
// Employee/Customer identity separation, RBAC join tables.
//
// Still NO business-logic modules (Workshop, Inventory, Finance, etc.) —
// those arrive in later phases per the project's incremental build rule.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (used at runtime)
  directUrl = env("DIRECT_URL")   // direct connection (used for migrations / prisma db push)
}

// ----------------------------------------------------------------------------
// MODULE REGISTRY — powers the "every route exists, only some are live" rule.
// The sidebar / router in apps/portal reads this instead of hardcoding which
// modules are active, so activating a module later is configuration only.
// ----------------------------------------------------------------------------
enum ModuleStatus {
  LIVE
  COMING_SOON
  DISABLED
}

model PlatformModule {
  id          String       @id @default(cuid())
  key         String       @unique // e.g. "workshop", "hr", "finance"
  name        String
  description String?
  status      ModuleStatus @default(COMING_SOON)
  sortOrder   Int          @default(0)
  icon        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  companyModules CompanyModule[]

  @@map("platform_modules")
}

// Per-company override of a module's status (a module can be COMING_SOON
// platform-wide but LIVE for one company once that company's build lands).
model CompanyModule {
  id        String       @id @default(cuid())
  companyId String
  moduleId  String
  status    ModuleStatus
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module    PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleId])
  @@map("company_modules")
}

// ----------------------------------------------------------------------------
// BRANDING — the dynamic branding engine. One row per company; every UI
// surface (portal, PDF templates, emails) reads colours from here instead of
// hardcoding them. Public website branding is also sourced from this model.
// ----------------------------------------------------------------------------
model Branding {
  id              String   @id @default(cuid())
  companyId       String   @unique
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  logoUrl         String?
  logoDarkUrl     String?
  faviconUrl      String?

  primaryColor    String   @default("#16A34A") // Kewalram default: green
  secondaryColor  String   @default("#0F172A")
  accentColor     String   @default("#22C55E")
  successColor    String   @default("#16A34A")
  warningColor    String   @default("#F59E0B")
  errorColor      String   @default("#DC2626")
  infoColor       String   @default("#2563EB")

  fontFamily      String   @default("Inter")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("branding")
}

// ----------------------------------------------------------------------------
// ORGANIZATION HIERARCHY
// Platform -> Company -> Business Unit -> Country -> State -> City -> Branch
//   -> Department -> Team -> User
// Every level is a normal configurable record — nothing here is hardcoded
// to Kewalram; Kewalram Nigeria is simply the first row seeded into it.
// ----------------------------------------------------------------------------

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  legalName   String?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branding      Branding?
  businessUnits BusinessUnit[]
  companyModules CompanyModule[]
  users         User[]
  roles         Role[]
  customers     Customer[]

  @@map("companies")
}

model BusinessUnit {
  id        String   @id @default(cuid())
  companyId String
  name      String   // e.g. "Automobile Division", "Afprint", "Sunola Foods"
  slug      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  countries CountryLink[]
  branches  Branch[]

  @@unique([companyId, slug])
  @@map("business_units")
}

model Country {
  id       String @id @default(cuid())
  name     String @unique // e.g. "Nigeria"
  isoCode  String @unique // e.g. "NG"

  states       State[]
  businessUnits CountryLink[]

  @@map("countries")
}

// Join table: which business units operate in which countries.
model CountryLink {
  id             String       @id @default(cuid())
  businessUnitId String
  countryId      String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  country        Country      @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([businessUnitId, countryId])
  @@map("business_unit_countries")
}

model State {
  id        String   @id @default(cuid())
  countryId String
  name      String   // e.g. "Lagos State"

  country   Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities    City[]

  @@unique([countryId, name])
  @@map("states")
}

model City {
  id      String @id @default(cuid())
  stateId String
  name    String // e.g. "Isolo"

  state    State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  branches Branch[]

  @@unique([stateId, name])
  @@map("cities")
}

model Branch {
  id             String   @id @default(cuid())
  businessUnitId String
  cityId         String
  name           String   // e.g. "Isolo Branch"
  code           String?  // short code used in document numbering, e.g. "KWL-WS"
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  city         City         @relation(fields: [cityId], references: [id], onDelete: Cascade)
  departments  Department[]
  users        User[]
  jobCards     JobCard[]
  parts          Part[]
  goodsReceipts  GoodsReceipt[]
  partRequestSlips PartRequestSlip[]
  externalProcurementRequests ExternalProcurementRequest[]
  partCategories PartCategory[]
  partTypes      PartType[]

  @@map("branches")
}

model Department {
  id        String   @id @default(cuid())
  branchId  String
  name      String   // e.g. "Workshop", "HR", "Finance", "Store"
  slug      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  teams  Team[]
  users  User[]
  jobCards JobCard[]

  @@unique([branchId, slug])
  @@map("departments")
}

model Team {
  id           String   @id @default(cuid())
  departmentId String
  name         String   // e.g. "Technicians", "Store Officers"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users      User[]

  @@map("teams")
}

// ----------------------------------------------------------------------------
// IDENTITY & ACCESS
// User = employees and platform administrators only. Customers are a
// separate model (see CUSTOMER section below) so an employee account can
// never satisfy a customer-dashboard query and vice versa, per the Phase 2
// requirement that the two account types stay fully isolated even though
// they share one Better Auth backend and one database.
//
// Session / Account / Verification below follow Better Auth's standard
// adapter schema (https://www.better-auth.com) — field names and shapes
// are dictated by that library, not invented here. Better Auth is
// configured with two-model support (see apps/portal/lib/auth.ts) mapping
// User -> "user" and Customer -> a second identity table via its
// multi-session/organization-free plugin approach; both write into these
// same Session/Account/Verification tables, discriminated by which foreign
// key (userId vs customerId) is populated.
// ----------------------------------------------------------------------------

enum AccountType {
  EMPLOYEE
  ADMIN
}

model User {
  id            String      @id @default(cuid())
  // Nullable: Better Auth creates this row on signup before an
  // administrator has necessarily assigned org placement (see
  // apps/portal/lib/auth.ts). A user with no companyId yet is invisible
  // everywhere except account settings until an admin assigns one.
  companyId     String?
  branchId      String?
  departmentId  String?
  teamId        String?

  accountType   AccountType @default(EMPLOYEE)

  employeeId    String?     @unique // human-facing staff number
  fullName      String
  email         String      @unique
  emailVerified Boolean     @default(false) // required by Better Auth
  image         String?                     // required by Better Auth (avatar URL)
  phone         String?
  photoUrl      String?

  isActive      Boolean     @default(true)
  lastLoginAt   DateTime?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  company    Company?    @relation(fields: [companyId], references: [id])
  branch     Branch?     @relation(fields: [branchId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  team       Team?       @relation(fields: [teamId], references: [id])

  roles           UserRole[]
  sessions        Session[]
  accounts        Account[]
  employeeProfile EmployeeProfile?
  jobCardsAssigned JobCard[] @relation("JobCardTechnician")
  jobCardsSupervised JobCard[] @relation("JobCardSupervisor")
  jobCardsApproved JobCard[] @relation("JobCardApprovedBy")
  estimateLineItemsEntered EstimateLineItem[]
  estimatesCreated Estimate[] @relation("EstimateCreatedBy")
  estimatesApproved Estimate[] @relation("EstimateApprovedBy")
  estimatesManagerApproved Estimate[] @relation("EstimateManagerApprovedBy")
  estimatesCustomerNotified Estimate[] @relation("EstimateCustomerNotifiedBy")
  paymentsRecorded Payment[]
  cancellationRequestsMade CancellationRequest[] @relation("CancellationRequestedBy")
  cancellationRequestsDecided CancellationRequest[] @relation("CancellationDecidedBy")
  jobCardsCreated  JobCard[] @relation("JobCardCreatedBy")
  customersCreated Customer[] @relation("CustomerCreatedBy")
  vehiclesCreated  CustomerVehicle[] @relation("VehicleCreatedBy")
  partsCreated       Part[] @relation("PartCreatedBy")
  partCategoriesCreated PartCategory[] @relation("PartCategoryCreatedBy")
  partTypesCreated      PartType[] @relation("PartTypeCreatedBy")
  goodsReceiptsTaken GoodsReceipt[] @relation("GoodsReceiptReceivedBy")
  partRequestSlipsRequested    PartRequestSlip[] @relation("PartRequestSlipRequestedBy")
  partRequestSlipsHodApproved  PartRequestSlip[] @relation("PartRequestSlipHodApprovedBy")
  partRequestSlipsStoreApproved PartRequestSlip[] @relation("PartRequestSlipStoreApprovedBy")
  partRequestSlipsReleased     PartRequestSlip[] @relation("PartRequestSlipReleasedBy")
  partRequestSlipsRejected     PartRequestSlip[] @relation("PartRequestSlipRejectedBy")
  partRequestSlipsReceived     PartRequestSlip[] @relation("PartRequestSlipReceivedBy")
  externalProcurementRequested       ExternalProcurementRequest[] @relation("ExternalProcurementRequestedBy")
  externalProcurementManagerApproved ExternalProcurementRequest[] @relation("ExternalProcurementManagerApprovedBy")
  externalProcurementDisbursed        ExternalProcurementRequest[] @relation("ExternalProcurementDisbursedBy")
  externalProcurementRejected         ExternalProcurementRequest[] @relation("ExternalProcurementRejectedBy")
  externalProcurementRetired          ExternalProcurementRequest[] @relation("ExternalProcurementRetiredBy")

  @@map("users")
}

// One-to-one HR extension of User. Kept separate per the Phase 1 note so
// the core identity table stays lean; HR-specific fields live here.
model EmployeeProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Employment
  jobTitle         String?
  employmentType   String?   // Full-time, Part-time, Contract, Intern, NYSC, Consultant...
  employmentStatus String?   // Active, Suspended, On Leave, Resigned, Retired, Terminated
  dateEmployed     DateTime?
  reportingManagerId String?

  // Emergency contact (kept inline — single contact per employee is enough
  // for Phase 2; promote to its own model if multiple contacts are needed)
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?

  // Signature / notification preferences
  signatureUrl               String?
  notifyByEmail               Boolean @default(true)
  notifyByInApp                Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents EmployeeDocument[]

  @@map("employee_profiles")
}

model EmployeeDocument {
  id                String          @id @default(cuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  type    String // CV, Employment Letter, Contract, Certificate, Medical Fitness...
  fileUrl String
  uploadedAt DateTime @default(now())

  @@map("employee_documents")
}

model Role {
  id          String   @id @default(cuid())
  companyId   String
  name        String   // e.g. "Technician", "Workshop Supervisor", "Administrator"
  slug        String
  description String?
  isSystem    Boolean  @default(false) // true for built-in roles that can't be deleted
  // Bypasses PermissionsGuard entirely (see apps/api/src/common/guards/
  // permissions.guard.ts) — grants every current AND future permission
  // without needing a RolePermission row per permission. Reserved for the
  // bootstrap Master Administrator / platform-owner role; do not grant
  // this to ordinary admin roles.
  isSuperAdmin Boolean @default(false)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([companyId, slug])
  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique // e.g. "workshop.job_card.approve"
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ----------------------------------------------------------------------------
// CUSTOMER IDENTITY — deliberately separate from User (employees/admins).
// Same Better Auth backend and database per Phase 2 requirements, but a
// customer session can never resolve to a User row, so a customer account
// structurally cannot reach an employee-only route.
// ----------------------------------------------------------------------------

// Whether a customer is an individual person or a registered company —
// real evidence for this distinction: an actual Kewalram paper estimate
// form shows a company customer ("F Trading Nig. Ltd.") alongside
// individual customers. `fullName` on Customer below covers either case
// as a single display name (a person's full name, or a company's name)
// — kept as one field rather than split into separate person/company
// name fields, since that's what the paper form itself does.
enum CustomerType {
  INDIVIDUAL
  ORGANIZATION
}

model Customer {
  id            String       @id @default(cuid())
  companyId     String       // which company this customer belongs to (Kewalram, etc.)

  customerType  CustomerType @default(INDIVIDUAL)
  fullName      String
  // Deliberately a single short line, not the separate, multi-field
  // CustomerAddress model below (label/line1/line2/city/state/country)
  // — that model is scaffolded for a fuller multi-address system this
  // project doesn't need yet. What's actually needed here is simpler:
  // one short address shown directly on the Job Card, kept brief on
  // purpose (like a VIN) so it never stretches that layout — enforced
  // with a UI character limit, not just a hint.
  address       String?
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  phone         String?

  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?

  // Nullable: a customer registered by Workshop staff has a real creator;
  // a customer who self-registers through the public portal in a future
  // phase would not, so this can't be a required field.
  createdById   String?
  createdBy     User?    @relation("CustomerCreatedBy", fields: [createdById], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions   CustomerSession[]
  accounts   CustomerAccount[]

  customerCompany CustomerCompany?
  vehicles        CustomerVehicle[]
  addresses       CustomerAddress[]
  contacts        CustomerContact[]
  jobCards        JobCard[]

  @@map("customers")
}

// Optional: when the customer is a business (fleet account) rather than
// an individual — e.g. a company that brings multiple vehicles in.
model CustomerCompany {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  companyName String
  taxId       String?

  @@map("customer_companies")
}

model CustomerVehicle {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  make         String?
  model        String?
  vehicleType  VehicleCategory? // Passenger vs Commercial — the Workshop's two operational sections
  year         Int?
  plateNumber  String?  @unique // no two vehicles may share a plate — this is what caused the visible duplicate-vehicle bug: nothing stopped a second/third accidental submit from creating another row for the same real vehicle
  chassisNumber String? @unique // VIN — globally unique per vehicle by definition
  engineNumber String?
  // The engine's own real-world spec/type (e.g. "ISF2.8", "4HK1") — the
  // actual compatibility key for parts fitment, deliberately distinct
  // from engineNumber above (the physical engine's own serial number,
  // a different concept entirely — the same distinction as a VIN vs.
  // a model name). Confirmed via real research: two vehicles sharing
  // a model name can have different engines (Tunland Petrol vs.
  // Diesel variants), while two different models can share the exact
  // same engine and be fully interchangeable for parts (Isuzu NPR and
  // NQR both on the 4HK1) — engine, not model name, is what actually
  // determines whether a part fits.
  engineType   String?
  mileage       Int?     // last known odometer reading, updated at each Job Card check-in

  createdById String? // staff member who registered this vehicle
  createdBy   User?   @relation("VehicleCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  jobCards JobCard[]

  @@map("customer_vehicles")
}

enum VehicleCategory {
  PASSENGER
  COMMERCIAL
}

// ----------------------------------------------------------------------------
// WORKSHOP — Phase 3. The first fully operational business module (per the
// project's phased build plan). Deliberately minimal for this pass: only
// the fields the current UI actually reads/writes are here. Estimate,
// Invoice, Part, and TechnicianAssignment are intentionally NOT modeled
// yet — they attach to JobCard in a later phase without requiring a
// redesign of this model, per the "don't build every module now" rule.
// ----------------------------------------------------------------------------

enum JobCardStatus {
  CHECKED_IN
  IN_PROGRESS
  AWAITING_PARTS
  QUALITY_CHECK
  // The workshop's own process is done and the estimate has been sent
  // to the customer — set the moment notifyCustomerOfApprovedEstimate
  // runs, not a separate manual step. Sits between the workshop's own
  // work and payment: nothing proceeds until the customer pays (or,
  // in a later phase, explicitly cancels).
  AWAITING_CUSTOMER_APPROVAL
  COMPLETED
  READY_FOR_COLLECTION
  CLOSED
  // The vehicle has physically left the workshop — the true "gate
  // exit" moment, distinct from CLOSED above (which only means the
  // job itself is administratively signed off; the vehicle can still
  // be sitting in the yard at that point). Reachable two ways: the
  // normal path (CLOSED, once collected and confirmed) or directly
  // from CANCELLED once an uncollected, dead Job Card's vehicle is
  // finally taken away — no other status is reachable from CANCELLED.
  CHECKED_OUT
  CANCELLED
}

// A separate dimension from JobCardStatus above — see the field comment
// on JobCard.approvalStatus for why these aren't combined into one enum.
enum JobCardApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Whether an assigned technician has agreed to take on the work —
// mirrors JobCardApprovalStatus's shape deliberately, same underlying
// idea (a real person's explicit response, not inferred from anything
// else) applied to a different actor at a different point in the flow.
enum TechnicianAcceptanceStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model JobCard {
  id          String        @id @default(cuid())
  jobNumber   String        @unique // human-facing, e.g. "JC-2026-000123" — generated server-side, never user-entered
  branchId    String
  customerId  String
  vehicleId   String
  // Which of the two Workshop departments (Passenger / Commercial) owns
  // this Job Card — auto-resolved at creation from vehicle.vehicleType,
  // never chosen manually. Nullable so every Job Card created before this
  // field existed keeps working unchanged; it simply won't appear in a
  // department-scoped HOD queue (a later phase), which is an honest,
  // disclosed limit for old data rather than something silently broken.
  departmentId String?

  complaint   String?       // legacy single-field complaint, kept for Job Cards created before per-item complaints existed — new Job Cards use `complaints` below instead
  diagnosis   String?       // technician/service-advisor findings, filled in after inspection
  mileageAtCheckIn Int?

  assignedTechnicianId String? // User.id — nullable until a technician is assigned
  // Whether the assigned technician has accepted the work — a separate
  // dimension from `status`/`approvalStatus` above, same principle:
  // being assigned isn't the same as having agreed to do it. Nullable
  // specifically because there's a real "no technician assigned yet"
  // state that isn't the same as "assigned but hasn't responded" — set
  // to PENDING the moment assignTechnician() runs, cleared back to null
  // if reassigned to someone else (their predecessor's accept/reject
  // has no bearing on a different person's assignment).
  technicianAcceptanceStatus   TechnicianAcceptanceStatus?
  technicianRespondedAt       DateTime?
  technicianRejectionReason   String? // required when the technician rejects, mirrors JobCard.rejectionReason's role for approval
  // The Workshop Supervisor/HOD of the resolved department, chosen by
  // whoever creates the Job Card from a list already filtered to that
  // department — this is the "first assignment always goes to the right
  // department's HOD" rule, enforced at the data layer (createJobCard
  // validates the chosen supervisor actually belongs to the resolved
  // department, not just trusting client input).
  supervisorId String?
  createdById String        // User.id — staff member who opened this Job Card

  status      JobCardStatus @default(CHECKED_IN)
  notes       String?

  // Approval is deliberately a SEPARATE dimension from `status` above,
  // not a value within it — a Job Card can be `CHECKED_IN` in status
  // while simultaneously `PENDING` in approval; these answer two
  // different questions ("where is it in the physical workflow" vs
  // "has the supervisor signed off on it") and shouldn't be forced into
  // one field. This is the explicit approval tracking asked for: never
  // inferred from status alone.
  approvalStatus   JobCardApprovalStatus @default(PENDING)
  approvedById     String?   // User.id — who approved or rejected it
  approvedAt       DateTime? // when the current approvalStatus was set
  rejectionReason  String?   // short, required when rejecting — e.g. "Incomplete vehicle information"
  approvalNotes    String?   // optional longer commentary, on either an approval or a rejection

  closedAt    DateTime?
  // Set the moment status genuinely transitions to READY_FOR_COLLECTION
  // — the anchor for that status's own collection-grace deadline
  // (READY_FOR_COLLECTION_GRACE_WORKING_DAYS), the same pattern as
  // Estimate.customerNotifiedAt and CancellationRequest.decidedAt
  // anchoring their own deadlines. Nullable and safe on the existing
  // populated table: no default needed, since every row that predates
  // this field genuinely never reached this status under it.
  readyForCollectionAt DateTime?
  // Set the first time status genuinely reaches IN_PROGRESS — the
  // real start of technical work, distinct from CHECKED_IN (which
  // only means the vehicle has arrived and is being inspected/
  // estimated, not yet worked on). Never overwritten on a later
  // return to IN_PROGRESS (e.g. after AWAITING_PARTS resolves) — this
  // marks when work genuinely began, not every moment it resumed.
  workStartedAt DateTime?
  // Set the first time status genuinely reaches COMPLETED — paired
  // with workStartedAt to measure actual repair duration specifically
  // (technician's own turnaround), deliberately distinct from the
  // later, separate Ready for Collection step, since collection
  // timing is a logistics/customer factor, not a reflection of how
  // long the technical work itself took.
  completedAt DateTime?
  // Set the first time status genuinely reaches CHECKED_OUT — the
  // true physical-exit moment. This, not closedAt (an administrative
  // sign-off that can happen while the vehicle is still sitting in
  // the yard), is the real end of "time in custody": the vehicle can
  // be CLOSED and still physically present for a while before this is
  // set.
  checkedOutAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  department         Department?         @relation(fields: [departmentId], references: [id])
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle            CustomerVehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  assignedTechnician User?               @relation("JobCardTechnician", fields: [assignedTechnicianId], references: [id])
  supervisor         User?               @relation("JobCardSupervisor", fields: [supervisorId], references: [id])
  approvedBy         User?               @relation("JobCardApprovedBy", fields: [approvedById], references: [id])
  createdBy          User                @relation("JobCardCreatedBy", fields: [createdById], references: [id])
  complaints         JobCardComplaint[]
  estimate           Estimate?
  payments           Payment[]
  cancellationRequests CancellationRequest[]
  partRequestSlips     PartRequestSlip[]
  externalProcurementRequests ExternalProcurementRequest[]

  @@map("job_cards")
}

// One row per distinct reported issue on a Job Card — e.g. "Fan not
// working" and "AC not working" as two separate, numbered entries,
// rather than one free-text paragraph mixing multiple complaints
// together. `sequenceNumber` preserves the order they were entered in
// (the order the customer/staff actually listed them), independent of
// database insertion order.
model JobCardComplaint {
  id             String   @id @default(cuid())
  jobCardId      String
  jobCard        JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  sequenceNumber Int
  description    String
  createdAt      DateTime @default(now())

  @@map("job_card_complaints")
}

// One Estimate per Job Card for now — `version` exists so a later
// phase (controlled technician-estimate-revision approval) can extend
// this into real versioning without restructuring what's built here;
// it's not yet incremented or acted on anywhere in this phase.
// DRAFT while the technician and supervisor are still building it up —
// prices can be left blank at this stage, since real workshop practice
// is that different people fill in their own portion at different
// times (technician prices external/outside work, Store prices parts,
// supervisor/company sets labour and sundry). SUBMITTED once the
// technician marks it done and sends it to the supervisor to validate
// — every line must have a price by this point, enforced at the
// transition, not before. APPROVED once the supervisor signs off.
// Manager-level approval and the customer/admin-facing hand-off are a
// later phase, not modeled here yet.
// DRAFT while the technician and supervisor are still building it up —
// prices can be left blank at this stage. SUBMITTED once the
// technician marks it done and sends it to the supervisor to validate
// — every line must have a price by this point. APPROVED once the
// supervisor signs off — NOT yet the final word; it now moves to the
// Workshop Manager for their own review. MANAGER_APPROVED is this
// phase's actual terminal state — the customer is notified once an
// estimate reaches it.
enum EstimateStatus {
  DRAFT
  SUBMITTED
  APPROVED
  MANAGER_APPROVED
}

model Estimate {
  id          String         @id @default(cuid())
  jobCardId   String         @unique
  status      EstimateStatus @default(DRAFT)
  version     Int            @default(1)
  submittedAt DateTime?
  approvedAt  DateTime?
  approvedById String?
  // The Workshop Manager's own sign-off, distinct from the
  // supervisor's approvedAt/approvedById above — a Manager oversees a
  // whole branch (both Passenger and Commercial departments), not one
  // department the way a Supervisor does, so eligibility for this step
  // is checked by branch, not department (see
  // listEligibleManagersForBranch in workshop.ts).
  managerApprovedAt   DateTime?
  managerApprovedById String?
  // Gates the actual customer notification separately from
  // MANAGER_APPROVED — the Manager approving is not the same as
  // anyone deciding the customer should be told. That decision
  // belongs to whoever created the Job Card (the front-desk/admin
  // staff who opened it and is accountable for the customer
  // relationship), reusing JobCard.createdById rather than inventing
  // a distinct "Admin" role — see notifyCustomerOfApprovedEstimate in
  // workshop.ts.
  customerNotifiedAt   DateTime?
  customerNotifiedById String?
  // Set the moment the approval-deadline reminder email is actually
  // sent — exists purely to prevent sending it twice, not a general
  // audit field. Nullable and safe on an already-populated table:
  // no default needed for existing rows, since "no reminder sent yet"
  // is the correct, meaningful state for every row that predates this
  // field.
  reminderSentAt       DateTime?
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  jobCard     JobCard            @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("EstimateCreatedBy", fields: [createdById], references: [id])
  approvedBy  User?              @relation("EstimateApprovedBy", fields: [approvedById], references: [id])
  managerApprovedBy User?        @relation("EstimateManagerApprovedBy", fields: [managerApprovedById], references: [id])
  customerNotifiedBy User?       @relation("EstimateCustomerNotifiedBy", fields: [customerNotifiedById], references: [id])
  lineItems   EstimateLineItem[]

  @@map("estimates")
}

// The five kinds of entry a real workshop estimate needs, each with
// different accountability AND, critically, different pricing
// authority — who is actually allowed to fill in the price differs by
// type, enforced in code (see requirePricingAuthority below):
//   STORE_PART    — Store staff (auto-fill once real inventory sync
//                   exists — each part will carry its own fixed price;
//                   that sync is a later phase, this one just tracks
//                   it as a manually-priced line for now).
//   EXTERNAL_PART — a part the technician sourced from outside the
//                   workshop. Priced by the technician — they're the
//                   one who bought it, they're the one who knows what
//                   it cost.
//   EXTERNAL_JOB  — work done outside (e.g. cylinder resurfacing,
//                   lathe work on a brake disc), NOT a part. Priced by
//                   the technician for the same reason as EXTERNAL_PART.
//                   The cash-advance/receipt side of both external
//                   types is a later phase; this one just tracks the
//                   cost as a line.
//   INTERNAL_JOB  — named work performed inside the workshop itself
//                   (wheel alignment, wheel balancing, body work,
//                   painting, gas/AC refill, engine overhaul, battery
//                   charging, diesel injector servicing, etc.) — a
//                   genuinely separate concept from LABOUR below, not
//                   a relabeling of it. Plural by nature: one Job Card
//                   can need several of these at once, so unlike
//                   SUNDRY there is no one-line cap here. Priced by
//                   the supervisor/company, never the technician.
//   LABOUR        — the company's own labour/time charge for a
//                   specific piece of work — e.g. "Labour for
//                   Service", "Labour for Brake" — confirmed by an
//                   actual Kewalram paper estimate, which shows both
//                   as separate lines on the same job. Also plural by
//                   nature, same as INTERNAL_JOB, no one-line cap.
//                   Priced by the supervisor/company.
//   SUNDRY        — miscellaneous small charges, naturally a single
//                   aggregate rather than several distinct items — a
//                   Job Card may only ever have ONE Sundry line
//                   (enforced in code, not the schema — a second
//                   attempt is rejected with a clear message pointing
//                   at editing the existing one instead). Priced by
//                   the supervisor/company.
// `enteredById` matters more here than usual precisely because these
// types have different people accountable for getting them right.
enum EstimateLineItemType {
  STORE_PART
  EXTERNAL_PART
  EXTERNAL_JOB
  INTERNAL_JOB
  LABOUR
  SUNDRY
}

model EstimateLineItem {
  id          String               @id @default(cuid())
  estimateId  String
  type        EstimateLineItemType
  description String
  quantity    Int                  @default(1)
  // Both nullable now — a DRAFT-stage line can exist with no price yet
  // (see EstimateStatus above); `amount` is only ever computed and
  // stored once both quantity and unitPrice are actually known, never
  // trusted from client input either way.
  unitPrice   Decimal?             @db.Decimal(12, 2)
  amount      Decimal?             @db.Decimal(12, 2)
  enteredById String
  createdAt   DateTime             @default(now())
  // `@default(now())` alongside `@updatedAt` is deliberate, not
  // redundant — `@updatedAt` alone tells Prisma's client to keep this
  // current on every future update, but gives the migration itself no
  // database-level default to backfill EXISTING rows with. Two real
  // rows already existed here from testing the earlier phase, so the
  // migration correctly refused to add this as a required column with
  // nothing to put in them — confirmed directly from the actual
  // deploy error, not guessed at. The explicit default fixes that.
  updatedAt   DateTime             @default(now()) @updatedAt
  // Both only ever meaningful for a STORE_PART line — set by the
  // technician (which generic kind of part is needed, e.g. "Fuel
  // Filter") and by Store (which real, vehicle-fitting catalog Part
  // actually satisfies it), two separate moments by two separate
  // people. Null on every other line type, and null on a STORE_PART
  // line until each step actually happens — a freshly-added
  // STORE_PART line has a partType but not yet a matchedPart,
  // exactly reflecting where it stands.
  partTypeId    String?
  matchedPartId String?

  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  enteredBy   User     @relation(fields: [enteredById], references: [id])
  requestSlipLines PartRequestSlipLine[]
  externalProcurementRequests ExternalProcurementRequest[]
  partType    PartType? @relation(fields: [partTypeId], references: [id])
  matchedPart Part?     @relation("EstimateLineItemMatchedPart", fields: [matchedPartId], references: [id])

  @@map("estimate_line_items")
}

// A payment toward a Job Card's estimate — deliberately one-to-many,
// not one-to-one, since the 70% deposit model means a Job Card
// realistically sees at least two payments (deposit, then balance).
// Recorded by Finance staff after seeing proof of a bank transfer or
// receiving cash at the cashier — a real, minimal record rather than
// a bare boolean "paid" flag, so there's an actual audit trail of who
// recorded what, how much, and by which method. The customer
// uploading their own proof directly, and a real payment gateway,
// are both later phases — this is the foundation they'd build on.
enum PaymentMethod {
  BANK_TRANSFER
  CASH
}

model Payment {
  id            String        @id @default(cuid())
  jobCardId     String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  notes         String?       // e.g. a transfer reference or receipt number
  recordedById  String
  recordedAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  jobCard       JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  recordedBy    User    @relation(fields: [recordedById], references: [id])

  @@map("payments")
}

// A cancellation request stays entirely separate from JobCard.status
// itself until a Manager actually approves it — a declined request
// never needs to "revert" anything, because nothing was ever touched
// in the first place. Deliberately one-to-many (like Payment above):
// a Job Card could see a declined request followed later by a second,
// genuine one. The reason is required at request time (an employee's
// note explaining why, whether that came from the customer by email,
// phone, in person, or the customer's own dashboard) and shown to the
// Manager for their decision; the Manager's own decision note is
// separately recorded, whichever way they decide.
enum CancellationRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

model CancellationRequest {
  id            String                    @id @default(cuid())
  jobCardId     String
  reason        String
  requestedById String
  requestedAt   DateTime                  @default(now())
  status        CancellationRequestStatus @default(PENDING)
  decidedById   String?
  decidedAt     DateTime?
  decisionNotes String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @default(now()) @updatedAt

  jobCard     JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("CancellationRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?   @relation("CancellationDecidedBy", fields: [decidedById], references: [id])

  @@map("cancellation_requests")
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label      String? // "Home", "Office"
  line1      String
  line2      String?
  city       String?
  state      String?
  country    String?

  @@map("customer_addresses")
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name  String
  phone String?
  email String?
  role  String? // e.g. "Fleet Manager"

  @@map("customer_contacts")
}

// ----------------------------------------------------------------------------
// BETTER AUTH TABLES
// Standard Better Auth schema (see https://www.better-auth.com/docs/concepts/database).
// Field names/shapes are dictated by the library's Prisma adapter — do not
// rename without also updating apps/portal/lib/auth.ts. Employee/Admin
// sessions and Customer sessions are kept in physically separate tables
// (rather than one shared table with two nullable FKs) — that is what
// actually guarantees a customer token cannot be presented to an
// employee-only guard, matching the Phase 2 isolation requirement.
// ----------------------------------------------------------------------------

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String    // "credential", "google", "microsoft"...
  password              String?   // set for the "credential" (email+password) provider — this is Better Auth's own field name for its Prisma adapter; it must be exactly "password", not renamed, since no field-mapping override is configured in apps/portal/lib/auth.ts
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@map("accounts")
}

model CustomerSession {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String   @unique
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("customer_sessions")
}

model CustomerAccount {
  id                    String    @id @default(cuid())
  customerId            String
  customer              Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  password              String?   // same field-name requirement as Account.password above
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@map("customer_accounts")
}

// Shared by both auth flows — email verification, password reset, etc.
// Better Auth keys this by (identifier, value), not by user, so one table
// safely serves both Employee and Customer flows.
model Verification {
  id         String   @id @default(cuid())
  identifier String   // typically the email being verified/reset
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@map("verifications")
}

// ----------------------------------------------------------------------------
// AUDIT LOG — required from Phase 1 per the "nothing deletable, everything
// timestamped" rule; every future module writes into this same table.
// ----------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // e.g. "user.created", "job_card.approved"
  entityType String   // e.g. "JobCard"
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// STORE / INVENTORY — Phase 1: the part catalog, unit-of-measure conversion,
// stock representation, and goods receipt (stock coming in). Deliberately
// does NOT yet include the Issue Slip workflow (requesting/releasing stock
// to a Job Card) or External Procurement (cash-advance sourcing) — those
// are their own later phases, built once this foundation exists.
//
// Three tracking types cover every real item this store handles, matching
// standard ERP Materials Management practice (SAP's own Quantity/Batch/
// Serialized distinction) rather than forcing one model onto everything:
//   QUANTITY   — a single running total, e.g. brake pads, filters, WD-40.
//   BATCH      — stock grouped by the delivery it arrived in, e.g. engine
//                oil, coolant, brake fluid — lets a bad batch be traced to
//                exactly which vehicles received it, without serializing
//                every bottle.
//   SERIALIZED — every physical unit has its own identity, e.g. tyres,
//                rims, and (later) higher-value parts like alternators.
//
// Unit of measure follows the same base-unit + alternative-unit-with-
// conversion-factor pattern used everywhere in real inventory systems:
// stock is always held in one base unit (e.g. Liters for engine oil), but
// goods receipt can be recorded in whatever unit it actually arrived in
// (a Drum, a Case) and is converted automatically — the same drum-and-cans
// scenario described when this was designed.
// ----------------------------------------------------------------------------

enum PartTrackingType {
  QUANTITY
  BATCH
  SERIALIZED
}

enum PartSerialStatus {
  IN_STOCK
  ISSUED
}

model Part {
  id          String @id @default(cuid())
  branchId    String
  name        String
  description String?
  // A simple string, not a separate category table — this project's own
  // pattern of not over-building a piece until it's genuinely needed
  // (e.g. JobCard.approvalStatus vs status being kept as two simple
  // dimensions rather than one complex one). Free text now; if real
  // category-based reporting becomes a genuine need later, this can grow
  // into its own model without breaking anything already stored.
  category    String?
  // Internal reference code — distinct from `barcode` below, which is
  // reserved for the future barcode-scanning phase and unused for now.
  partNumber  String?
  barcode     String?
  trackingType PartTrackingType @default(QUANTITY)
  // The unit stock is always held in internally, regardless of what unit
  // a delivery physically arrives in — e.g. "Liter" for engine oil,
  // "Each" for brake pads. Never converted; alternativeUnits below convert
  // TO this one, not the other way around.
  baseUnitOfMeasure String
  // Reserved for future replenishment automation — not yet acted on by
  // any code, but present now so adding it later doesn't need a schema
  // change once that automation is actually built.
  reorderPoint Decimal? @db.Decimal(12, 3)
  safetyStock  Decimal? @db.Decimal(12, 3)
  isActive     Boolean  @default(true)
  // Which generic, customer-facing PartType this Part actually is
  // (e.g. "Fuel Filter") — nullable since a Part can exist in the
  // catalog before ever being categorized this way, but this is what
  // lets a technician's plain-language estimate request ("Fuel
  // Filter") match against every real vehicle-specific Part that
  // could satisfy it (this one, plus e.g. "Fuel Filter — Foton TM3" —
  // same PartType, two genuinely different Parts). Deliberately
  // separate from the free-text `category` field above: category is
  // a simple, broad browsing bucket Store already uses for its own
  // catalog search; PartType is a specific, structured, reusable
  // classification with its own parent PartCategory (see below) —
  // the two serve different purposes and neither replaces the other.
  partTypeId   String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User     @relation("PartCreatedBy", fields: [createdById], references: [id])
  partType  PartType? @relation(fields: [partTypeId], references: [id])

  alternativeUnits  PartUnitOfMeasure[]
  stock             PartStock?
  batches           PartBatch[]
  serials           PartSerial[]
  goodsReceiptLines GoodsReceiptLine[]
  requestSlipLines  PartRequestSlipLine[]
  fitments          PartFitment[]
  matchedOnEstimateLines EstimateLineItem[] @relation("EstimateLineItemMatchedPart")

  @@unique([branchId, partNumber])
  @@map("parts")
}

// An alternative unit a delivery might arrive in, and the factor to
// convert it to the part's own base unit — e.g. unitName "Drum",
// conversionFactor 200, for a part whose base unit is "Liter" (1 Drum =
// 200 Liters). Goods receipt looks these up so a storekeeper can enter a
// delivery exactly as it physically arrived, not force-converted by hand.
model PartUnitOfMeasure {
  id               String  @id @default(cuid())
  partId           String
  unitName         String
  conversionFactor Decimal @db.Decimal(12, 4)

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([partId, unitName])
  @@map("part_units_of_measure")
}

// The single, always-current aggregate for a part — works directly as the
// real stock figure for QUANTITY-tracked parts, and doubles as a fast,
// always-in-sync running total for BATCH/SERIALIZED parts (whose real
// detail lives in PartBatch/PartSerial respectively) so a dashboard or
// reorder check never has to sum every batch or serial row just to answer
// "how much do we have."
model PartStock {
  id               String   @id @default(cuid())
  partId           String   @unique
  quantityOnHand   Decimal  @default(0) @db.Decimal(14, 4)
  // Reserved for the future Issue Slip phase — the moment a request is
  // approved, the requested quantity moves here so a second request
  // can't be promised the same stock before the first is released.
  // Present now, unused until that phase, matching reorderPoint/
  // safetyStock above.
  quantityReserved Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt        DateTime @updatedAt

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@map("part_stock")
}

// One row per delivery batch for a BATCH-tracked part — e.g. "received one
// 200L drum of engine oil on 2026-08-29, 152L remaining after issues."
// remainingQuantity is decremented at goods issue (the future Issue Slip
// phase); receivedQuantity never changes once recorded, so the two
// together always show both the original delivery size and what's left.
model PartBatch {
  id                 String    @id @default(cuid())
  partId             String
  batchNumber        String
  receivedQuantity   Decimal   @db.Decimal(14, 4)
  remainingQuantity  Decimal   @db.Decimal(14, 4)
  receivedAt         DateTime  @default(now())
  expiryDate         DateTime?
  goodsReceiptLineId String?

  part             Part              @relation(fields: [partId], references: [id], onDelete: Cascade)
  goodsReceiptLine GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id])

  @@unique([partId, batchNumber])
  @@map("part_batches")
}

// One row per physical unit for a SERIALIZED part — e.g. one tyre, one
// rim. status flips to ISSUED at goods issue (the future Issue Slip
// phase); a serial is never deleted once received, preserving a complete
// history of every individual unit that ever passed through the store.
model PartSerial {
  id                 String           @id @default(cuid())
  partId             String
  serialNumber       String
  status             PartSerialStatus @default(IN_STOCK)
  receivedAt         DateTime         @default(now())
  goodsReceiptLineId String?

  part             Part              @relation(fields: [partId], references: [id], onDelete: Cascade)
  goodsReceiptLine GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id])

  @@unique([partId, serialNumber])
  @@map("part_serials")
}

// The header for a delivery of stock arriving into the store — mirrors
// JobCard's own human-readable reference-number pattern (GRN-2026-000001,
// same generation logic as JC-2026-000001) so it reads the same way
// across the whole platform.
model GoodsReceipt {
  id              String   @id @default(cuid())
  branchId        String
  referenceNumber String   @unique
  supplierName    String
  receivedById    String
  receivedAt      DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())

  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  receivedBy User               @relation("GoodsReceiptReceivedBy", fields: [receivedById], references: [id])
  lines      GoodsReceiptLine[]

  @@map("goods_receipts")
}

// One line per part received on a single delivery. quantityReceivedInUnit
// and unitUsed record exactly what the storekeeper actually entered (e.g.
// "1 Drum"); quantityInBaseUnit is the converted amount that's genuinely
// added to stock (e.g. "200 Liters") — both kept, so the original delivery
// record and the real stock effect are each independently visible, never
// only the converted figure with the original entry lost.
model GoodsReceiptLine {
  id                     String   @id @default(cuid())
  goodsReceiptId         String
  partId                 String
  quantityReceivedInUnit Decimal  @db.Decimal(14, 4)
  unitUsed               String
  quantityInBaseUnit     Decimal  @db.Decimal(14, 4)
  unitCost               Decimal? @db.Decimal(12, 2)
  // Only meaningful for a BATCH-tracked part — the batch this line
  // creates or adds to.
  batchNumber            String?

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  part         Part         @relation(fields: [partId], references: [id])
  batches      PartBatch[]
  serials      PartSerial[]

  @@map("goods_receipt_lines")
}

// ----------------------------------------------------------------------------
// PARTS REQUEST SLIP & EXTERNAL PROCUREMENT — the two sourcing paths a Job
// Card's estimate can genuinely need, auto-detected from its own line item
// types (STORE_PART vs EXTERNAL_PART/EXTERNAL_JOB) rather than a human having
// to decide which flow applies — a Job Card can need one, the other, both, or
// neither, purely depending on what its own estimate actually contains.
//
// Both paths only ever become available once a Job Card's status genuinely
// reaches IN_PROGRESS or later — the same 70%-paid gate that already governs
// when the estimate itself becomes visible, reused rather than duplicated.
// ----------------------------------------------------------------------------

enum PartRequestSlipStatus {
  PENDING_HOD_APPROVAL
  PENDING_STORE_APPROVAL
  APPROVED
  RELEASED
  REJECTED
}

enum ExternalProcurementStatus {
  PENDING_MANAGER_APPROVAL
  APPROVED
  DISBURSED
  REJECTED
}

// The Store side — three real approval steps, not four: a Workshop HOD
// confirms the request itself is legitimate, Store confirms and reserves the
// stock (PartStock.quantityReserved moves here, not at release, so a second
// request can't be promised the same stock the first one already claimed),
// and a Storekeeper physically releases it. Mirrors JobCard's own jobNumber
// pattern for its reference number (PRS-2026-000001).
model PartRequestSlip {
  id              String                @id @default(cuid())
  referenceNumber String                @unique
  jobCardId       String
  branchId        String
  requestedById   String
  status          PartRequestSlipStatus @default(PENDING_HOD_APPROVAL)

  hodApprovedById String?
  hodApprovedAt   DateTime?
  hodNotes        String?

  storeApprovedById String?
  storeApprovedAt   DateTime?
  storeNotes        String?

  releasedById String?
  releasedAt   DateTime?
  // Who physically collected it — a real system user where possible (the
  // assigned technician, a colleague who helped), or plain text where not
  // (an intern without their own account). Kept on the header, not per
  // line: one person collects everything on a slip in one trip in real
  // physical practice, not a different collector per part.
  receivedByUserId String?
  receivedByName   String?

  rejectedById    String?
  rejectedAt      DateTime?
  // Which stage actually rejected it (HOD or STORE) — kept as its own
  // field rather than inferred from which approval timestamp is null,
  // since a rejection can happen at either stage and the record should
  // say plainly which one, not make someone work it out.
  rejectionStage  String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  jobCard        JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  requestedBy    User     @relation("PartRequestSlipRequestedBy", fields: [requestedById], references: [id])
  hodApprovedBy  User?    @relation("PartRequestSlipHodApprovedBy", fields: [hodApprovedById], references: [id])
  storeApprovedBy User?   @relation("PartRequestSlipStoreApprovedBy", fields: [storeApprovedById], references: [id])
  releasedBy     User?    @relation("PartRequestSlipReleasedBy", fields: [releasedById], references: [id])
  receivedByUser User?    @relation("PartRequestSlipReceivedBy", fields: [receivedByUserId], references: [id])
  rejectedBy     User?    @relation("PartRequestSlipRejectedBy", fields: [rejectedById], references: [id])
  lines          PartRequestSlipLine[]

  @@map("part_request_slips")
}

model PartRequestSlipLine {
  id                 String   @id @default(cuid())
  slipId             String
  partId             String
  // Traceability back to the exact estimate line this sources — optional
  // since a request could in principle be raised without a strict 1:1
  // match to an existing estimate line.
  estimateLineItemId String?
  // In the part's own base unit, matching how Goods Receipt already
  // works — a request is entered in whatever unit makes sense, but
  // reservation and release always happen against the base unit.
  quantityRequested  Decimal  @db.Decimal(14, 4)
  quantityReleased   Decimal? @db.Decimal(14, 4)

  slip             PartRequestSlip   @relation(fields: [slipId], references: [id], onDelete: Cascade)
  part             Part              @relation(fields: [partId], references: [id])
  estimateLineItem EstimateLineItem? @relation(fields: [estimateLineItemId], references: [id])

  @@map("part_request_slip_lines")
}

// The External side — a genuine cash advance (an imprest, in real
// accounting terms): a technician requests money for a specific purchase,
// a Manager approves it, Finance disburses the actual cash. Reconciling
// it against a receipt afterward ("Advance Retirement") needs the
// Attachment/Storage system, which doesn't exist yet — retiredById/
// retiredAt are reserved here now, unused until that phase, the same
// "reserve the field, build the feature later" pattern already used for
// Part.reorderPoint/safetyStock.
model ExternalProcurementRequest {
  id                 String                     @id @default(cuid())
  referenceNumber    String                     @unique
  jobCardId          String
  branchId           String
  estimateLineItemId String?
  requestedById      String
  description        String
  estimatedAmount    Decimal                    @db.Decimal(12, 2)
  status             ExternalProcurementStatus  @default(PENDING_MANAGER_APPROVAL)

  managerApprovedById String?
  managerApprovedAt   DateTime?
  managerNotes        String?

  disbursedById     String?
  disbursedAt       DateTime?
  // The real amount actually handed over — may differ slightly from
  // estimatedAmount, which is why both are kept rather than one
  // overwriting the other.
  disbursedAmount   Decimal? @db.Decimal(12, 2)

  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?

  retiredById String?
  retiredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  jobCard          JobCard           @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  estimateLineItem EstimateLineItem? @relation(fields: [estimateLineItemId], references: [id])
  requestedBy      User              @relation("ExternalProcurementRequestedBy", fields: [requestedById], references: [id])
  managerApprovedBy User?            @relation("ExternalProcurementManagerApprovedBy", fields: [managerApprovedById], references: [id])
  disbursedBy      User?             @relation("ExternalProcurementDisbursedBy", fields: [disbursedById], references: [id])
  rejectedBy       User?             @relation("ExternalProcurementRejectedBy", fields: [rejectedById], references: [id])
  retiredBy        User?             @relation("ExternalProcurementRetiredBy", fields: [retiredById], references: [id])

  @@map("external_procurement_requests")
}

// ----------------------------------------------------------------------------
// PART FITMENT — which real vehicles a Part actually fits, confirmed via real
// research on Isuzu NPR/NQR/QMR/QLR and Foton Tunland/TM3: the genuine
// compatibility key is the ENGINE, not the marketing model name — two
// different models can share an engine and be fully interchangeable (NPR and
// NQR both use the 4HK1), while the same-looking model name across a fuel
// variant can have a genuinely different engine. A rigid single Make/Model
// field on Part can't express "fits two models but not a third," which is
// exactly the real situation this was designed around — hence a real,
// separate many-to-many table instead.
//
// A Part with ZERO fitment rows means "fits everything" — no extra rows
// needed for the parts that are already universal (Engine Oil, Coolant,
// Brake Fluid, Penetrating Oil never needed a fitment restriction in the
// first place).
// ----------------------------------------------------------------------------

model PartFitment {
  id     String @id @default(cuid())
  partId String
  make   String
  model  String
  // Null means "fits every engine of this make/model" — only set when a
  // part genuinely varies by engine within the same model (the real case
  // this was built for), never set as a formality when it doesn't matter.
  engineType String?
  // Optional year range — specs can change across model years even under
  // the same name. Null on either end means unbounded in that direction.
  yearFrom Int?
  yearTo   Int?

  createdAt DateTime @default(now())

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@map("part_fitments")
}

// ----------------------------------------------------------------------------
// PART CATEGORY / PART TYPE — the real, two-level hierarchy a technician
// actually browses at estimate time, confirmed against a real example:
//
//   Filter (PartCategory)              Fluid (PartCategory)
//   ├── Oil Filter (PartType)          ├── Coolant (PartType)
//   └── Fuel Filter (PartType)         ├── Engine Oil (PartType)
//                                      └── Brake Fluid (PartType)
//
// PartCategory is the broad, parent grouping ("Filter", "Fluid",
// "Brakes"). PartType is the specific, customer-facing kind of part a
// technician actually picks ("Fuel Filter", "Engine Oil") — this is what
// appears on the estimate a customer sees, never a vehicle-specific
// catalog Part or its price. One PartType can sit above several real
// Parts — "Fuel Filter — Foton Tunland" and "Fuel Filter — Foton TM3"
// are two genuinely different Parts (confirmed necessary in the Vehicle
// Fitment phase — same engine family doesn't always mean the same
// physical part), but both are the generic idea of "Fuel Filter" as far
// as a technician needs to think about it. Store is the one who narrows
// a PartType down to the one real, correct, vehicle-fitting Part — using
// the fitment-matching logic already built.
//
// Deliberately separate from Part.category (a simple, free-text browsing
// bucket Store's own catalog search already uses) — that field predates
// this hierarchy and keeps working exactly as it did; this is a new,
// structured classification built specifically for the technician/
// estimate-facing side, not a replacement for it.
// ----------------------------------------------------------------------------

model PartCategory {
  id          String   @id @default(cuid())
  branchId    String
  name        String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User   @relation("PartCategoryCreatedBy", fields: [createdById], references: [id])

  partTypes PartType[]

  @@unique([branchId, name])
  @@map("part_categories")
}

model PartType {
  id          String   @id @default(cuid())
  branchId    String
  categoryId  String
  name        String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category  PartCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy User         @relation("PartTypeCreatedBy", fields: [createdById], references: [id])

  parts             Part[]
  estimateLineItems EstimateLineItem[]

  @@unique([branchId, categoryId, name])
  @@map("part_types")
}

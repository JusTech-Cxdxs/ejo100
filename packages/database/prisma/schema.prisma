  requestedBy       User                   @relation("ContractorRequestedBy", fields: [requestedById], references: [id])
  managerApprovedBy User?                  @relation("ContractorApprovedBy", fields: [managerApprovedById], references: [id])
  revokedBy         User?                  @relation("ContractorRevokedBy", fields: [revokedById], references: [id])
  attendance        ContractorAttendance[]

  @@index([status])

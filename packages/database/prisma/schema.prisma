  declinedBy        User?           @relation("RoadTestDeclinedBy", fields: [declinedById], references: [id])
  gateOutBy         User?           @relation("RoadTestGateOutBy", fields: [gateOutById], references: [id])
  gateInBy          User?           @relation("RoadTestGateInBy", fields: [gateInById], references: [id])
  people            RoadTestPerson[]

  @@index([status])
  @@index([jobCardId])
  @@index([vehicleServiceId])
  @@map("road_test_permits")

  status         DeliveryStatus
  supplierName   String
  reference      String?
  items          String
  expectedAt     DateTime?
  driverName     String?
  driverPhone    String?
  vehicleType    String?
  vehiclePlate   String?
  notes          String?
  registeredById String
  arrivedAt      DateTime?
  arrivedById    String?
  receivedAt     DateTime?
  receivedById   String?
  receiptNote    String?
  goodsReceiptId String?
  leftAt         DateTime?
  leftById       String?
  cancelReason   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt


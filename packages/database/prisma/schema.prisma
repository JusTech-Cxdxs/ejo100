  pass        ContractorPass @relation(fields: [passId], references: [id], onDelete: Cascade)
  signedInBy  User           @relation("ContractorSignedInBy", fields: [signedInById], references: [id])
  signedOutBy User?          @relation("ContractorSignedOutBy", fields: [signedOutById], references: [id])

